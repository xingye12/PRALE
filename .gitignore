# Bytecode and caches: rebuilt from source, never shared.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Packaging output.
build/
dist/
*.egg-info/
.venv/
venv/

# A deployment's own state.  The launcher defaults PRALE_DATA_DIR outside the
# checkout; this covers the server's own default (<project_root>/.prale) and any
# run pointed back into the tree.  It is the whole history — sessions, memory,
# skills, traces — not something to commit.
.prale/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Deployment configuration, which holds a live provider key and service tokens.
# deploy/web.env.example stays tracked: only the exact name is ignored, so the
# template next to it is still visible to git.
web.env
*_api_key
