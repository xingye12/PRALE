@@ -0,0 +1,17 @@
+// ESM resolve hook: redirect `server/core/config-queue.js`'s single dependency
+// (`./gateway-client.js`) to the deterministic in-process stub used by the contract
+// fixture. Only that one edge is rewritten; `config-queue.js` itself is loaded unmodified.
+//
+// The heavy real module chain (gateway-client.js -> multi-tenant-gateway.js) needs
+// runtime dependencies that are not installed in this checkout, so this hook keeps the
+// fixture executable with a stock `node` binary.
+
+const STUB_URL = new URL('./gateway-client-stub.mjs', import.meta.url).href
+
+export async function resolve (specifier, context, nextResolve) {
+  const parent = context.parentURL || ''
+  if (specifier === './gateway-client.js' && parent.endsWith('/server/core/config-queue.js')) {
+    return { url: STUB_URL, shortCircuit: true }
+  }
+  return nextResolve(specifier, context)
+}
diff --git a/server/core/contract-fixtures/gateway-client-stub.mjs b/server/core/contract-fixtures/gateway-client-stub.mjs
new file mode 100644
index 0000000..c2d98f6
--- /dev/null
+++ b/server/core/contract-fixtures/gateway-client-stub.mjs
@@ -0,0 +1,79 @@
+// Deterministic in-memory Gateway stub for the ConfigQueue contract fixture.
+//
+// It replaces `server/core/gateway-client.js` (see ./gateway-client-loader.mjs) so the
+// real `ConfigQueue` implementation in `server/core/config-queue.js` can be driven
+// end-to-end without a live OpenClaw Gateway and without installed dependencies.
+
+let callLog = []
+let scriptedFailures = []
+let state = { hash: 'hash-0', version: 0, config: {} }
+let patchCount = 0
+let applyCount = 0
+
+function isPlainObject (value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+function deepMerge (base, patch) {
+  const out = { ...base }
+  for (const [key, value] of Object.entries(patch)) {
+    out[key] = isPlainObject(value) && isPlainObject(base?.[key])
+      ? deepMerge(base[key], value)
+      : value
+  }
+  return out
+}
+
+/** Program the fake gateway before a scenario runs. */
+export function __configure ({ config = {}, failures = [] } = {}) {
+  callLog = []
+  scriptedFailures = failures.map(f => ({ ...f }))
+  state = { hash: 'hash-0', version: 0, config: structuredClone(config) }
+  patchCount = 0
+  applyCount = 0
+}
+
+/** Ordered list of rpc method names observed by the fake gateway. */
+export function __calls () {
+  return callLog.map(c => c.method)
+}
+
+/** Full rpc trace including params (params are JSON-normalised for stability). */
+export function __trace () {
+  return callLog.map(c => ({ method: c.method, params: JSON.parse(JSON.stringify(c.params ?? {})) }))
+}
+
+export function __snapshot () {
+  return { calls: __calls(), state: structuredClone(state), patchCount, applyCount }
+}
+
+export async function gatewayAdminRpc (method, params = {}) {
+  callLog.push({ method, params })
+
+  if (scriptedFailures.length > 0 && scriptedFailures[0].method === method) {
+    const { message } = scriptedFailures.shift()
+    return { ok: false, error: message }
+  }
+
+  if (method === 'config.get') {
+    return { ok: true, payload: { sourceConfig: state.config, config: state.config, parsed: state.config, hash: state.hash } }
+  }
+
+  if (method === 'config.patch' || method === 'config.set') {
+    if (params.baseHash !== state.hash) return { ok: false, error: 'config changed since last load' }
+    const raw = JSON.parse(params.raw)
+    state.config = method === 'config.set' ? raw : deepMerge(state.config, raw)
+    state.version += 1
+    state.hash = `hash-${state.version}`
+    patchCount += 1
+    return { ok: true, payload: {} }
+  }
+
+  if (method === 'config.apply') {
+    if (params.baseHash !== state.hash) return { ok: false, error: 'config changed since last load' }
+    applyCount += 1
+    return { ok: true, payload: {} }
+  }
+
+  return { ok: false, error: `stub: unknown method ${method}` }
+}
