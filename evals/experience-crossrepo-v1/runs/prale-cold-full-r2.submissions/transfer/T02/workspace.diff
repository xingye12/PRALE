index 0000000..2702486
--- /dev/null
+++ b/server/core/contract-fixtures/config-queue-failure-settlement.demo.mjs
@@ -0,0 +1,193 @@
+// ============================================================================
+// Contract fixture: "first job fails, next job still settles deterministically"
+// ----------------------------------------------------------------------------
+// Executable, dependency-free demo that drives the REAL `ConfigQueue`
+// implementation from `server/core/config-queue.js` (the module is imported
+// unmodified; only its `./gateway-client.js` edge is redirected to the
+// deterministic in-process stub by ./gateway-client-loader.mjs).
+//
+// Contract under test (see docs/config-queue-architecture.md):
+//   ConfigQueue is a FIFO serial queue. Every enqueued job must settle exactly
+//   once - the failing job is rejected and the NEXT job in the same queue must
+//   still be dequeued, executed and settled (resolved), even though it was
+//   enqueued before the failure happened. A failure must not wedge `_process()`
+//   (i.e. `_running` must be released) and must not leak an unhandled rejection.
+//
+// Run:  node server/core/contract-fixtures/config-queue-failure-settlement.demo.mjs
+// Exit: 0 = all contract assertions hold, 1 = contract violated.
+// ============================================================================
+
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import { register } from 'node:module'
+
+register(new URL('./gateway-client-loader.mjs', import.meta.url))
+
+const { configQueueExecute } = await import('../config-queue.js')
+const gateway = await import('./gateway-client-stub.mjs')
+
+const REPLAY = process.env.CONTRACT_REPLAY === '1'
+const SETTLE_TIMEOUT_MS = 5000
+
+const unhandled = []
+process.on('unhandledRejection', (err) => { unhandled.push(String(err && err.message ? err.message : err)) })
+
+// ---------------------------------------------------------------- helpers ---
+const settleOrder = []
+
+function withTimeout (promise, label) {
+  return Promise.race([
+    promise.then(
+      (value) => { settleOrder.push(label); return { state: 'fulfilled', value } },
+      (error) => { settleOrder.push(label); return { state: 'rejected', error } }
+    ),
+    new Promise((_, reject) => setTimeout(() => reject(new Error(`job ${label} never settled within ${SETTLE_TIMEOUT_MS}ms`)), SETTLE_TIMEOUT_MS))
+  ])
+}
+
+const encode = (outcome) => outcome.state === 'rejected'
+  ? `REJECTED:${outcome.error.message}`
+  : `RESOLVED:${outcome.value === undefined ? 'undefined' : JSON.stringify(outcome.value)}`
+
+// --------------------------------------------------------------- fixture ----
+const BASE_CONFIG = {
+  channels: { feishu: { accounts: { a1: { appId: 'cli_a1' } } } },
+  models: { providers: { alpha: { id: 'alpha' } } },
+  meta: { version: 1 }
+}
+
+async function runFixture () {
+  const report = { scenarios: {}, unhandledRejections: [], settlementOrder: [] }
+
+  // ---- Scenario 1: first job fails at the write stage (config.patch) --------
+  gateway.__configure({
+    config: BASE_CONFIG,
+    failures: [{ method: 'config.patch', message: 'rpc transport closed' }]
+  })
+  settleOrder.length = 0
+
+  const jobA = withTimeout(
+    configQueueExecute(
+      (sourceConfig) => ({ ...sourceConfig, channels: { feishu: { accounts: { ...sourceConfig.channels.feishu.accounts, a2: { appId: 'cli_a2' } } } } }),
+      'fixture-A-write-fails'
+    ),
+    'fixture-A-write-fails'
+  )
+  const jobB = withTimeout(
+    configQueueExecute(
+      (sourceConfig) => ({ ...sourceConfig, meta: { ...sourceConfig.meta, version: 2 } }),
+      'fixture-B-settles'
+    ),
+    'fixture-B-settles'
+  )
+
+  const [outA, outB] = await Promise.all([jobA, jobB])
+  const snap1 = gateway.__snapshot()
+
+  assert.equal(encode(outA), 'REJECTED:rpc transport closed', 'job A must reject with the transport error')
+  assert.equal(encode(outB), 'RESOLVED:undefined', 'job B must settle with the config.patch success value')
+  assert.deepEqual(settleOrder, ['fixture-A-write-fails', 'fixture-B-settles'], 'jobs must settle in FIFO order')
+  assert.deepEqual(snap1.calls, ['config.get', 'config.patch', 'config.get', 'config.patch', 'config.get', 'config.apply'],
+    'job A stops at its failed patch; job B then runs the full read/patch/read/apply sequence')
+  assert.equal(snap1.patchCount, 1, 'only job B may land a patch')
+  assert.equal(snap1.applyCount, 1, 'only job B may land an apply')
+  assert.deepEqual(snap1.state.config, {
+    channels: { feishu: { accounts: { a1: { appId: 'cli_a1' } } } },
+    models: { providers: { alpha: { id: 'alpha' } } },
+    meta: { version: 2 }
+  }, 'failed job A must leave no trace; job B mutation is applied')
+
+  report.scenarios['first-job-fails-at-write-next-job-settles'] = {
+    jobA: encode(outA),
+    jobB: encode(outB),
+    calls: snap1.calls,
+    gateway: { patchCount: snap1.patchCount, applyCount: snap1.applyCount, hash: snap1.state.hash, config: snap1.state.config }
+  }
+
+  // ---- Scenario 2: first job fails at the read stage (config.get) ----------
+  gateway.__configure({
+    config: BASE_CONFIG,
+    failures: [{ method: 'config.get', message: 'gateway offline: econnrefused' }]
+  })
+  settleOrder.length = 0
+
+  const jobC = withTimeout(
+    configQueueExecute(() => ({ ...BASE_CONFIG, meta: { version: 99 } }), 'fixture-C-read-fails'),
+    'fixture-C-read-fails'
+  )
+  const jobD = withTimeout(
+    configQueueExecute(
+      (sourceConfig) => ({ ...sourceConfig, models: { providers: { ...sourceConfig.models.providers, beta: { id: 'beta' } } } }),
+      'fixture-D-settles'
+    ),
+    'fixture-D-settles'
+  )
+
+  const [outC, outD] = await Promise.all([jobC, jobD])
+  const snap2 = gateway.__snapshot()
+
+  assert.equal(encode(outC), 'REJECTED:gateway offline: econnrefused', 'job C must reject with the read error')
+  assert.equal(encode(outD), 'RESOLVED:undefined', 'job D must settle despite job C failing first')
+  assert.deepEqual(settleOrder, ['fixture-C-read-fails', 'fixture-D-settles'], 'FIFO settlement holds for the read-stage failure too')
+  assert.deepEqual(snap2.calls, ['config.get', 'config.get', 'config.patch', 'config.get', 'config.apply'],
+    'the failed read consumes one config.get and the next job proceeds with a fresh read')
+  assert.equal(snap2.patchCount, 1, 'job D lands exactly one patch')
+  assert.equal(snap2.state.config.meta.version, 1, 'job C mutation was never applied')
+  assert.deepEqual(snap2.state.config.models.providers, { alpha: { id: 'alpha' }, beta: { id: 'beta' } })
+
+  report.scenarios['first-job-fails-at-read-next-job-settles'] = {
+    jobC: encode(outC),
+    jobD: encode(outD),
+    calls: snap2.calls,
+    gateway: { patchCount: snap2.patchCount, applyCount: snap2.applyCount, hash: snap2.state.hash, config: snap2.state.config }
+  }
+
+  // ---- Scenario 3: liveness probe - queue is not wedged by the failures ----
+  gateway.__configure({ config: BASE_CONFIG })
+  settleOrder.length = 0
+
+  const [outE, outF] = await Promise.all([
+    withTimeout(configQueueExecute(() => null, 'fixture-E-noop'), 'fixture-E-noop'),
+    withTimeout(configQueueExecute(() => null, 'fixture-F-noop'), 'fixture-F-noop')
+  ])
+  const snap3 = gateway.__snapshot()
+
+  assert.equal(encode(outE), 'RESOLVED:null', 'no-op job E must settle with null (transform returned null)')
+  assert.equal(encode(outF), 'RESOLVED:null', 'no-op job F must settle with null')
+  assert.deepEqual(settleOrder, ['fixture-E-noop', 'fixture-F-noop'], 'probes settle in FIFO order')
+  assert.deepEqual(snap3.calls, ['config.get', 'config.get'], 'no-op jobs read but never patch')
+  assert.equal(snap3.patchCount, 0, 'no-op jobs must not patch')
+  assert.equal(snap3.state.config.meta.version, 1, 'no-op jobs must not mutate the gateway config')
+
+  report.scenarios['queue-still-alive-after-failures'] = {
+    jobE: encode(outE),
+    jobF: encode(outF),
+    calls: snap3.calls,
+    gateway: { patchCount: snap3.patchCount, applyCount: snap3.applyCount, hash: snap3.state.hash, config: snap3.state.config }
+  }
+
+  report.unhandledRejections = [...unhandled]
+  report.settlementOrder = [...settleOrder]
+  assert.deepEqual(report.unhandledRejections, [], 'no unhandled rejection may leak from a failing queued job')
+  return report
+}
+
+// ---------------------------------------------------------------- driver ----
+const first = await runFixture()
+
+if (REPLAY) {
+  process.stdout.write(`${JSON.stringify(first)}\n`)
+} else {
+  const child = spawnSync(process.execPath, [new URL(import.meta.url).pathname], {
+    env: { ...process.env, CONTRACT_REPLAY: '1' },
+    encoding: 'utf8'
+  })
+  assert.equal(child.status, 0, `replay run failed: ${child.stderr}`)
+  const second = JSON.parse(child.stdout)
+
+  assert.deepStrictEqual(second, first, 'a clean re-run of the same fixture must produce an identical snapshot')
+
+  first.determinism = { replay: 'identical-snapshot', comparedAt: 'child-process' }
+  console.log(JSON.stringify(first, null, 2))
+  console.error('\n[contract] PASS - first job failed, subsequent jobs settled deterministically; replay snapshot identical.')
+}
