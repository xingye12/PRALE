new file mode 100644
index 0000000..1b43ba2
--- /dev/null
+++ b/.scratch/probe.mjs
@@ -0,0 +1,25 @@
+import { register } from 'node:module'
+const loader = `
+export async function resolve(specifier, context, next) {
+  if (specifier.startsWith('.') || specifier.startsWith('node:') || specifier.startsWith('/')) return next(specifier, context)
+  try { return await next(specifier, context) } catch {
+    return { url: 'stub:' + specifier, shortCircuit: true }
+  }
+}
+export async function load(url, context, next) {
+  if (url.startsWith('stub:')) {
+    const name = url.slice(5)
+    return { format: 'module', shortCircuit: true, source: 'export default new Proxy(function(){}, { get: () => undefined, apply: () => undefined })' }
+  }
+  return next(url, context)
+}
+`
+register(`data:text/javascript,${encodeURIComponent(loader)}`)
+try {
+  const sys = await import('../server/core/system.js')
+  console.log('system.js ok', Object.keys(sys).join(','))
+} catch (e) { console.log('system.js FAIL', e.message) }
+try {
+  const gw = await import('../server/core/gateway-client.js')
+  console.log('gateway-client ok', Object.keys(gw).join(','))
+} catch (e) { console.log('gateway-client FAIL', e.message) }
diff --git a/.scratch/probe2.mjs b/.scratch/probe2.mjs
new file mode 100644
index 0000000..fd3b6f0
--- /dev/null
+++ b/.scratch/probe2.mjs
@@ -0,0 +1,38 @@
+import { register } from 'node:module'
+const stubSource = `
+const makeStub = () => {
+  const target = function stub() {}
+  const handler = {
+    get(t, p) {
+      if (p === 'then' || p === Symbol.toStringTag || p === Symbol.toPrimitive) return undefined
+      if (p === 'default') return proxy
+      return proxy
+    },
+    apply() { return proxy },
+    construct() { return proxy },
+    set() { return true },
+  }
+  const proxy = new Proxy(target, handler)
+  return proxy
+}
+const proxy = makeStub()
+export default proxy
+`
+const loader = `
+const stubSource = ${JSON.stringify(stubSource)}
+export async function resolve(specifier, context, next) {
+  if (specifier.startsWith('.') || specifier.startsWith('node:') || specifier.startsWith('/')) return next(specifier, context)
+  try { return await next(specifier, context) } catch {
+    return { url: 'stub:' + specifier, shortCircuit: true }
+  }
+}
+export async function load(url, context, next) {
+  if (url.startsWith('stub:')) return { format: 'module', shortCircuit: true, source: stubSource }
+  return next(url, context)
+}
+`
+register(`data:text/javascript,${encodeURIComponent(loader)}`)
+try {
+  const gw = await import('../server/core/gateway-client.js')
+  console.log('gateway-client ok', Object.keys(gw).join(','))
+} catch (e) { console.log('gateway-client FAIL', e.message) }
