+++ b/tools/validate_lint_normalize.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""Focused validation for the T09 operate deliverable.
+
+Checks, from inside the workspace:
+  1. the fake linter honors its CLI contract (stdout findings, stderr diagnostics, exit 1);
+  2. tools/normalize_lint.py produces the normalized record with separated streams,
+     a nonzero exit carried through, and parsed findings;
+  3. .prale-eval/result.json matches the TASK.md metadata contract and its citations
+     really contain the named symbols at the declared inclusive line ranges;
+  4. .prale-eval/operate-deliverable.md exists and documents the operation.
+
+Run:  python3 tools/validate_lint_normalize.py -v
+"""
+
+import json
+import os
+import subprocess
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+RESULT_JSON = os.path.join(ROOT, ".prale-eval", "result.json")
+NORMALIZED_JSON = os.path.join(ROOT, ".prale-eval", "linter-result.json")
+DELIVERABLE_MD = os.path.join(ROOT, ".prale-eval", "operate-deliverable.md")
+FAKE_LINTER_CMD = "python3 tools/fake_linter.py tools/demo_target.py"
+
+
+def run(cmd):
+    return subprocess.run(
+        cmd, cwd=ROOT, shell=True, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
+    )
+
+
+def load_json(path):
+    with open(path) as fh:
+        return json.load(fh)
+
+
+class TestFakeLinterContract(unittest.TestCase):
+    def test_stdout_stderr_and_nonzero_exit(self):
+        proc = run(FAKE_LINTER_CMD)
+        self.assertEqual(proc.returncode, 1, "fake linter must exit nonzero on findings")
+        stdout_lines = [ln for ln in proc.stdout.splitlines() if ln.strip()]
+        stderr_lines = [ln for ln in proc.stderr.splitlines() if ln.strip()]
+        self.assertEqual(len(stdout_lines), 2)
+        self.assertTrue(all(": E" in ln or ": W" in ln for ln in stdout_lines))
+        self.assertTrue(all(ln.startswith("fake-linter:") for ln in stderr_lines))
+        self.assertNotIn("fake-linter:", proc.stdout)
+        self.assertNotIn("demo_target.py:3:1", proc.stderr)
+
+
+class TestNormalization(unittest.TestCase):
+    def test_normalized_record(self):
+        proc = run("python3 tools/normalize_lint.py")
+        self.assertEqual(proc.returncode, 0, "normalization itself must succeed")
+        self.assertTrue(os.path.exists(NORMALIZED_JSON))
+        record = load_json(NORMALIZED_JSON)
+
+        self.assertEqual(record["exit_code"], 1)
+        self.assertEqual(record["status"], "failed")
+        self.assertEqual(record["command"], FAKE_LINTER_CMD)
+        self.assertTrue(record["streams"]["separated"])
+        self.assertEqual(len(record["streams"]["stdout"]), 2)
+        self.assertEqual(len(record["streams"]["stderr"]), 3)
+
+        rules = [f["rule"] for f in record["findings"]]
+        self.assertEqual(rules, ["E501", "E231"])
+        self.assertTrue(all(f["parsed"] for f in record["findings"]))
+        self.assertEqual(record["summary"]["errors"], 2)
+        self.assertEqual(record["summary"]["files"], ["tools/demo_target.py"])
+
+        obs = record["observations"]
+        self.assertTrue(obs["stderr_folded_into_stdout_by_run_cmd"])
+        self.assertFalse(obs["repo_run_cmd_subprocess"]["streams_separated"])
+        self.assertEqual(obs["repo_run_cmd_subprocess"]["returncode"], 1)
+        self.assertTrue(obs["run_cmd_merged_union_of_streams"])
+
+    def test_optional_dependency_limitation_recorded(self):
+        record = load_json(NORMALIZED_JSON)
+        joined = " ".join(record.get("validation_limitations", []))
+        self.assertIn("pexpect", joined)
+
+
+class TestResultJsonContract(unittest.TestCase):
+    def setUp(self):
+        self.assertTrue(os.path.exists(RESULT_JSON), "result.json missing")
+        self.result = load_json(RESULT_JSON)
+
+    def test_metadata(self):
+        self.assertEqual(self.result["task_id"], "T09")
+        self.assertEqual(self.result["repository"], "aider")
+        self.assertEqual(self.result["mode"], "operate")
+
+    def test_top_level_keys(self):
+        for key in ("evidence", "claims", "conclusion", "validation"):
+            self.assertIn(key, self.result)
+        for key in ("command", "status", "notes"):
+            self.assertIn(key, self.result["validation"])
+
+    def test_evidence_citations_are_real(self):
+        paths = {entry["path"] for entry in self.result["evidence"]}
+        self.assertIn("aider/run_cmd.py", paths)
+        for entry in self.result["evidence"]:
+            for key in ("path", "symbol", "start_line", "end_line", "observation"):
+                self.assertIn(key, entry)
+            self.assertLessEqual(entry["start_line"], entry["end_line"])
+            abs_path = os.path.join(ROOT, entry["path"])
+            self.assertTrue(os.path.exists(abs_path), entry["path"])
+            with open(abs_path) as fh:
+                lines = fh.readlines()
+            self.assertLessEqual(entry["end_line"], len(lines))
+            span = "".join(lines[entry["start_line"] - 1 : entry["end_line"]])
+            symbol = entry["symbol"].split(".")[-1]
+            self.assertIn(symbol, span, f"{entry['symbol']} not inside declared range")
+
+    def test_claims_are_grounded(self):
+        valid = {entry["path"] for entry in self.result["evidence"]}
+        for claim in self.result["claims"]:
+            self.assertIn("claim", claim)
