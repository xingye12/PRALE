@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""A deterministic local *fake* linter used to exercise operate-mode normalization.
+
+Contract of the fake linter (deliberately mirrors real linter CLIs):
+
+* findings go to **stdout**, one per line, in ``path:line:col: RULE message`` form;
+* configuration / summary diagnostics go to **stderr**;
+* the process exits **nonzero** (1) because findings were reported.
+
+Usage:
+    python3 tools/fake_linter.py <path> [<path> ...]
+
+The exit codes are:
+    0  no findings
+    1  findings reported
+    2  bad invocation (no path given)
+"""
+
+import os
+import sys
+
+# path, line, column, rule, message, severity
+FINDINGS = [
+    ("{target}", 3, 1, "E501", "line too long (101 > 79 characters)", "error"),
+    ("{target}", 5, 9, "E231", "missing whitespace after ':'", "error"),
+]
+
+RULES = {}
+
+
+def emit_findings(target):
+    for path, line, col, rule, message, severity in FINDINGS:
+        path = path.format(target=target)
+        RULES.setdefault(path, []).append(rule)
+        sys.stdout.write(f"{path}:{line}:{col}: {rule} {message}\n")
+
+
+def main(argv):
+    targets = argv[1:]
+    if not targets:
+        sys.stderr.write("fake-linter: error: no input path given\n")
+        sys.stderr.write("usage: fake_linter.py <path> [<path> ...]\n")
+        return 2
+
+    for stream in (sys.stdout, sys.stderr):
+        try:
+            stream.reconfigure(line_buffering=True)
+        except AttributeError:  # pragma: no cover - python < 3.7
+            pass
+
+    sys.stderr.write("fake-linter: warning: no config file found; using defaults\n")
+
+    total = 0
+    for raw_target in targets:
+        target = os.path.relpath(raw_target)
+        emit_findings(target)
+        total += len(FINDINGS)
+
+    sys.stderr.write(f"fake-linter: {total} problem(s) found in {len(targets)} file(s)\n")
+    sys.stderr.write("fake-linter: exit status 1 (problems reported)\n")
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tools/normalize_lint.py b/tools/normalize_lint.py
new file mode 100644
index 0000000..62af5ec
--- /dev/null
+++ b/tools/normalize_lint.py
@@ -0,0 +1,242 @@
+#!/usr/bin/env python3
+"""Operate the local fake linter and normalize the observed result to JSON.
+
+The fake linter (``tools/fake_linter.py``) writes findings to stdout, diagnostics
+to stderr and exits nonzero.  This harness runs it through two capture paths:
+
+1. ``aider.run_cmd.run_cmd_subprocess`` -- the real repository helper used by
+   ``aider/linter.py``.  It folds stderr into stdout (``stderr=subprocess.STDOUT``),
+   so the observation is a single merged stream plus the return code.
+2. ``subprocess.run(..., capture_output=True)`` -- a stream-preserving capture
+   used to build the normalized record (stdout and stderr kept separate).
+
+The normalized record is printed as JSON and written to
+``.prale-eval/linter-result.json``.
+
+Process exit status is 0 when normalization itself succeeded; the *linter's*
+nonzero exit is carried in the record's ``exit_code``/``status`` fields.
+"""
+
+import importlib
+import json
+import os
+import re
+import subprocess
+import sys
+import types
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+FAKE_LINTER = os.path.join(HERE, "fake_linter.py")
+TARGET = os.path.join(ROOT, "tools", "demo_target.py")
+OUT_PATH = os.path.join(ROOT, ".prale-eval", "linter-result.json")
+
+# ---------------------------------------------------------------- run_cmd.py
+
+
+def _stub_optional_module(name, **attrs):
+    """aider/run_cmd.py imports pexpect/psutil at module scope for its interactive
+    (tty) code path.  They are optional here, so provide inert stand-ins when the
+    real distributions are absent, and report that as a validation limitation."""
+    try:
+        importlib.import_module(name)
+        return None
+    except ImportError:
+        module = types.ModuleType(name)
+        for key, value in attrs.items():
+            setattr(module, key, value)
+        sys.modules[name] = module
+        return name
+
+
+def load_run_cmd():
+    stubbed = []
+    for name, attrs in (
+        ("pexpect", {"ExceptionPexpect": type("ExceptionPexpect", (Exception,), {})}),
+        ("psutil", {"Process": object}),
+    ):
+        if _stub_optional_module(name, **attrs):
+            stubbed.append(name)
+
+    sys.path.insert(0, ROOT)
+    run_cmd_module = importlib.import_module("aider.run_cmd")
+    return run_cmd_module, stubbed
+
+
+# ------------------------------------------------------------------ the runs
+
+
+def build_command():
+    # Workspace-relative and interpreter-agnostic so the recorded command is
+    # reproducible from the repository root.
+    parts = ["python3", os.path.relpath(FAKE_LINTER, ROOT)]
+    parts.append(os.path.relpath(TARGET, ROOT))
+    return " ".join(parts)
+
+
+def observe_with_run_cmd_subprocess(run_cmd_module, command):
+    """Observation path 1: repository helper (stderr folded into stdout)."""
+    captured = []
+
+    class _Tee:
+        def __init__(self, stream):
+            self._stream = stream
+
+        def write(self, data):
+            captured.append(data)
+            return self._stream.write(data)
+
+        def flush(self):
+            return self._stream.flush()
+
+    real_stdout = sys.stdout
+    sys.stdout = _Tee(real_stdout)
+    try:
+        returncode, merged = run_cmd_module.run_cmd_subprocess(command, cwd=ROOT)
+    finally:
+        sys.stdout = real_stdout
+    return {
+        "helper": "aider.run_cmd.run_cmd_subprocess",
+        "returncode": returncode,
+        "merged_output": merged,
+        "return_shape": "tuple[int, str]",
+        "streams_separated": False,
+    }
+
+
+def observe_streams(command):
+    """Observation path 2: stream-preserving capture."""
+    proc = subprocess.run(
+        command,
+        cwd=ROOT,
+        shell=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    return {
+        "helper": "subprocess.run(capture_output=True)",
+        "returncode": proc.returncode,
+        "stdout": proc.stdout,
+        "stderr": proc.stderr,
+        "streams_separated": True,
+    }
+
+
+# --------------------------------------------------------------- normalization
+
+
+FINDING_RE = re.compile(
+    r"^(?P<path>[^:]+):(?P<line>\d+):(?P<col>\d+):\s+(?P<rule>[A-Za-z]+\d+)\s+(?P<message>.*)$"
+)
+
+
+def severity_of(rule):
+    return "error" if rule[:1] in ("E", "F") else "warning"
+
+
+def parse_findings(stdout_lines):
+    """stdout contract: ``<path>:<line>:<col>: <RULE> <message>``."""
+    findings = []
+    for raw in stdout_lines:
+        if not raw.strip():
+            continue
+        match = FINDING_RE.match(raw.strip())
+        if not match:
+            findings.append({"raw": raw, "parsed": False})
+            continue
+        path = match.group("path")
+        line = int(match.group("line"))
+        column = int(match.group("col"))
+        rule = match.group("rule")
+        message = match.group("message")
+        severity = severity_of(rule)
+        findings.append(
+            {
+                "path": path.replace("\\", "/"),
+                "line": line,
+                "column": column,
+                "rule": rule,
+                "severity": severity,
+                "message": message.strip(),
+                "raw": raw,
+                "parsed": True,
+            }
+        )
+    return findings
+
+
+def normalize(command, run_cmd_observation, stream_observation):
+    stdout_lines = stream_observation["stdout"].splitlines()
+    stderr_lines = stream_observation["stderr"].splitlines()
+    findings = parse_findings(stdout_lines)
+    errors = sum(1 for f in findings if f.get("severity") == "error")
+    warnings = sum(1 for f in findings if f.get("severity") == "warning")
+    returncode = stream_observation["returncode"]
+
+    return {
+        "operation": "operate.fake_linter",
+        "command": command,
+        "cwd": ".",
+        "target": os.path.relpath(TARGET, ROOT),
+        "exit_code": returncode,
+        "status": "passed" if returncode == 0 else "failed",
+        "streams": {
+            "stdout": stdout_lines,
+            "stderr": stderr_lines,
+            "separated": True,
+        },
+        "findings": findings,
+        "summary": {
+            "problems": len(findings),
+            "errors": errors,
+            "warnings": warnings,
+            "files": sorted({f["path"] for f in findings if f.get("parsed")}),
+        },
+        "observations": {
+            "stream_preserving_capture": stream_observation,
+            "repo_run_cmd_subprocess": run_cmd_observation,
+            "stderr_folded_into_stdout_by_run_cmd": True,
+            # run_cmd_subprocess interleaves both streams into one pipe, so the
+            # merged text carries the same *lines* as stdout+stderr but not the
+            # same stream identity.
+            "run_cmd_merged_union_of_streams": (
+                sorted(run_cmd_observation["merged_output"].splitlines())
+                == sorted(stdout_lines + stderr_lines)
+            ),
+            "run_cmd_merged_line_count": len(run_cmd_observation["merged_output"].splitlines()),
+            "separated_stream_line_count": len(stdout_lines) + len(stderr_lines),
+        },
+        "normalization": {
+            "stdout_contract": "<path>:<line>:<col>: <RULE> <message>",
+            "stderr_contract": "diagnostics/summary lines, not findings",
+            "nonzero_exit_means": "failed (findings reported)",
+            "normalized_streams": 2,
+        },
+    }
+
+
+def main():
+    command = build_command()
+    run_cmd_module, stubbed = load_run_cmd()
+
+    run_cmd_observation = observe_with_run_cmd_subprocess(run_cmd_module, command)
+    stream_observation = observe_streams(command)
+    record = normalize(command, run_cmd_observation, stream_observation)
+    record["validation_limitations"] = [
+        f"optional dependency '{name}' not installed; stubbed for import only"
+        for name in stubbed
+    ]
+
+    os.makedirs(os.path.dirname(OUT_PATH), exist_ok=True)
+    with open(OUT_PATH, "w") as fh:
+        json.dump(record, fh, indent=2, sort_keys=False)
+        fh.write("\n")
+
+    json.dump(record, sys.stdout, indent=2)
+    sys.stdout.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
