+		},
+		{
+			"path": "packages/agent/src/harness/execution/tools.ts",
+			"symbol": "executeToolCall",
+			"start_line": 125,
+			"end_line": 158,
+			"observation": "executeToolCall crosses the external effect boundary inside gate.admit, calls abortSignal.throwIfAborted() before the try block (so a refused admission never invokes the tool), returns { result, isError: false } only from the successful await call.tool.execute(...) path, and catches every throw into { result: createErrorToolResult(...), isError: true }. The failure is reported as an error result and never as a success."
+		},
+		{
+			"path": "packages/agent/src/harness/runtime/drive/tools.ts",
+			"symbol": "publishToolIntent",
+			"start_line": 187,
+			"end_line": 227,
+			"observation": "publishToolIntent commits the durable retryable intent before the effect is attempted: it writes the prepared arguments to pi.op.tool_args, replaces the call with { status: 'effect_pending', ..., replay }, and emits tool_start. Because this commit precedes performToolInvocation/executeToolCall, a crash mid-effect leaves a persisted intent that recovery can retry, instead of a record that could be mistaken for terminal success."
+		},
+		{
