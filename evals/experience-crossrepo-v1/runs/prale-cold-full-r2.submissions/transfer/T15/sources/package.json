{
  "name": "openclaw-web",
  "private": true,
  "version": "0.2.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file=.env.local server/index.js",
    "dev:all": "concurrently -n \"frontend,backend\" -c \"blue,green\" \"vite\" \"node --env-file=.env server/index.js\"",
    "build": "vue-tsc -b && vite build",
    "build:test": "vue-tsc -b && vite build --mode test",
    "test:server": "vitest run server/core/session-sync.test.js server/core/usage-sync.test.js server/core/session-usage-cache.test.js server/handlers/cron.test.js server/services/feishu-project-sync.test.js server/user-manager.test.js --exclude '**/.claude/**' --exclude '**/.tmp/**' && node --test --test-force-exit server/services/external-session-projection.test.js server/utils/generated-file-metadata.test.js",
    "db:hygiene": "node scripts/db-hygiene.mjs",
    "preview": "vite preview",
    "start": "node --env-file=.env server/index.js",
    "deploy:test": "bash ./deploy-test.sh deploy",
    "deploy:test:fresh": "bash ./deploy-test.sh fresh",
    "reset:test:data": "bash ./deploy-test.sh fresh",
    "stop:test": "bash ./deploy-test.sh stop"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@iconify-json/vscode-icons": "^1.2.55",
    "@iconify/vue": "^5.0.1",
    "@noble/ed25519": "^3.0.0",
    "@types/katex": "^0.16.8",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.6.2",
    "check-disk-space": "^3.4.0",
    "cors": "^2.8.6",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.44",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "multer": "^2.0.2",
    "naive-ui": "^2.43.2",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.21.0",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "tar": "^7.5.11",
    "unzipper": "^0.12.3",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-i18n": "^9.0.0",
    "vue-pdf-embed": "^2.1.4",
    "vue-router": "^4.6.4",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "eventsource": "^4.1.0",
    "happy-dom": "^20.7.0",
    "playwright": "^1.58.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^4.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.1.5"
  }
}
