+    return {
+      requestedPath,
+      candidatePath,
+      pathMode,
+      relativePath,
+      status: 403,
+      reason: 'access-denied',
+    }
+  }
+
+  return {
+    requestedPath,
+    candidatePath,
+    pathMode,
+    relativePath,
+    status: 200,
+    attachment: {
+      name: posix.basename(candidatePath),
+      path: relativePath,
+      mimeType: generatedFileMimeType(candidatePath),
+    },
+  }
+}
