+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+	createLocalRpcAdapter,
+	ERROR_BODY_KEYS,
+	ERROR_CODES,
+	ERROR_ENVELOPE_KEYS,
+	isErrorEnvelope,
+	isSuccessEnvelope,
+	reject,
+} from "./rpc-adapter-demo.mjs";
+
+const INVALID_REQUESTS = [
+	null,
+	undefined,
+	42,
+	"echo",
+	[],
+	{},
+	{ command: "" },
+	{ command: "   " },
+	{ command: 7 },
+	{ command: "echo", params: "nope" },
+	{ command: "echo", params: [] },
+	{ command: "echo", params: {} },
+	{ command: "echo", params: { text: "" } },
+	{ command: "echo", params: { text: 42 } },
+	{ command: "echo", params: { text: "hi", unexpected: true } },
+	{ command: "sum", params: { values: [1, "two"] } },
+	{ command: "sum", params: { values: "1,2" } },
+	{ command: "unknown.command" },
+];
+
+test("valid input runs the fake effect once and returns the normalized success result", () => {
+	const adapter = createLocalRpcAdapter();
+	const outcome = adapter.dispatch({ command: "echo", params: { text: "hello" } });
+
+	assert.equal(isSuccessEnvelope(outcome), true);
+	assert.deepEqual(Object.keys(outcome), ["ok", "result"]);
+	assert.deepEqual(outcome.result, { applied: true, command: "echo", payload: { echoed: "hello" } });
+	assert.equal(adapter.effect.count(), 1);
+	assert.deepEqual(adapter.effect.entries(), [{ command: "echo", payload: { echoed: "hello" } }]);
+});
+
+test("invalid input is rejected before the fake effect runs", () => {
+	for (const request of INVALID_REQUESTS) {
+		const adapter = createLocalRpcAdapter();
+		const outcome = adapter.dispatch(request);
+
+		assert.equal(isErrorEnvelope(outcome), true, `expected stable error shape for ${JSON.stringify(request)}`);
+		assert.equal(outcome.ok, false);
+		assert.equal(
+			adapter.effect.count(),
+			0,
+			`fake effect must not run for invalid input ${JSON.stringify(request)}`,
+		);
+		assert.deepEqual(adapter.effect.entries(), []);
+	}
+});
+
+test("invalid input produces specific, actionable error codes", () => {
+	const adapter = createLocalRpcAdapter();
+
+	assert.equal(adapter.dispatch(null).error.code, ERROR_CODES.INVALID_REQUEST);
+	assert.equal(adapter.dispatch({ command: "" }).error.code, ERROR_CODES.INVALID_REQUEST);
+	assert.equal(adapter.dispatch({ command: "missing" }).error.code, ERROR_CODES.UNKNOWN_COMMAND);
+	assert.equal(adapter.dispatch({ command: "echo", params: {} }).error.code, ERROR_CODES.INVALID_PARAMS);
+	assert.equal(adapter.dispatch({ command: "echo", params: { text: 1 } }).error.code, ERROR_CODES.INVALID_PARAMS);
+	assert.equal(adapter.effect.count(), 0);
+});
+
+test("every rejection uses exactly the same error shape", () => {
+	const adapter = createLocalRpcAdapter();
+	const outcomes = [
+		...INVALID_REQUESTS.map((request) => adapter.dispatch(request)),
+		// a command body that throws at effect time is normalized the same way
+		adapter.dispatch({ command: "explode" }),
+		// and so is a locally constructed rejection
+		reject(ERROR_CODES.EFFECT_FAILED, "boom", { command: "explode" }),
+	];
+
+	for (const outcome of outcomes) {
+		assert.equal(isErrorEnvelope(outcome), true);
+		assert.deepEqual(Object.keys(outcome), [...ERROR_ENVELOPE_KEYS]);
+		assert.deepEqual(Object.keys(outcome.error), [...ERROR_BODY_KEYS]);
+		assert.equal(typeof outcome.error.code, "string");
+		assert.equal(typeof outcome.error.message, "string");
+		assert.equal(typeof outcome.error.details, "object");
+	}
+});
+
+test("dispatch never throws, not even for garbage or throwing commands", () => {
+	const adapter = createLocalRpcAdapter();
+	const garbage = [null, undefined, 0, "", NaN, [], {}, () => {}, Symbol("x")];
+	for (const request of garbage) {
+		assert.doesNotThrow(() => adapter.dispatch(request));
+	}
+	assert.doesNotThrow(() => adapter.dispatch({ command: "explode" }));
+	assert.equal(adapter.dispatch({ command: "explode" }).error.code, ERROR_CODES.EFFECT_FAILED);
+	assert.equal(adapter.effect.count(), 0);
+});
+
+test("the fake effect only records valid calls", () => {
+	const adapter = createLocalRpcAdapter();
+	adapter.dispatch({ command: "nope" });
+	adapter.dispatch({ command: "sum", params: { values: [1, 2] } });
+	adapter.dispatch({ command: "sum", params: { values: [3] } });
+
+	assert.equal(adapter.effect.count(), 2);
+	assert.deepEqual(
+		adapter.effect.entries(),
+		[
+			{ command: "sum", payload: { total: 3 } },
+			{ command: "sum", payload: { total: 3 } },
+		],
+	);
+});
