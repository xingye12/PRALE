{
  "schema": "wattclaw.demo.gateway-config.v1",
  "comment": "Local fake gateway/config fixture for demo T23. Field names mirror the tenant records consumed by server/core/multi-tenant-gateway.js (resolveConfig -> normalizeTenant -> getHttpTargetForCurrentRequest). port 0 means: bind an ephemeral fake backend on 127.0.0.1 at demo runtime and publish the resolved port, exactly like a provisioned tenant gets a concrete host/port.",
  "gateway": {
    "mode": "multi-tenant",
    "bindHost": "127.0.0.1",
    "rpcPath": "/api/v1/admin/rpc"
  },
  "tenants": [
    {
      "id": "tenant-a",
      "containerName": "openclaw-tenant-a",
      "host": "127.0.0.1",
      "port": 0,
      "token": "demo-token-tenant-a",
      "dataSource": "/srv/wattclaw/tenant-a",
      "maxUsers": 5,
      "status": "active"
    },
    {
      "id": "tenant-b",
      "containerName": "openclaw-tenant-b",
      "host": "127.0.0.1",
      "port": 0,
      "token": "demo-token-tenant-b",
      "dataSource": "/srv/wattclaw/tenant-b",
      "maxUsers": 5,
      "status": "active"
    }
  ],
  "users": [
    { "id": "demo-alice", "username": "alice", "displayName": "Alice", "role": "user" },
    { "id": "demo-bob", "username": "bob", "displayName": "Bob", "role": "user" }
  ],
  "assignments": [
    { "userId": "demo-alice", "tenantId": "tenant-a" },
    { "userId": "demo-bob", "tenantId": "tenant-b" }
  ]
}
