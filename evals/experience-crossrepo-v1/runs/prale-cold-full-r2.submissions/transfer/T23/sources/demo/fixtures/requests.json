{
  "schema": "wattclaw.demo.requests.v1",
  "comment": "Inbound admin-RPC requests for demo T23. Each case names the authenticated user, the tenant the caller asks for, and the expected normalized operation result. Cases are executed in order so that the mismatch case can prove no extra bytes reached any fake backend.",
  "cases": [
    {
      "name": "allowed-tenant-a",
      "user": "demo-alice",
      "requestedTenantId": "tenant-a",
      "rpc": { "method": "sessions.list", "params": { "limit": 10 } },
      "expect": {
        "status": 200,
        "dispatched": true,
        "backendTenantId": "tenant-a",
        "authorization": "Bearer demo-token-tenant-a"
      }
    },
    {
      "name": "mismatched-tenant-b",
      "user": "demo-alice",
      "requestedTenantId": "tenant-b",
      "rpc": { "method": "sessions.list", "params": { "limit": 10 } },
      "expect": {
        "status": 403,
        "dispatched": false,
        "errorContains": "tenant mismatch",
        "noNewBackendRequests": true
      }
    },
    {
      "name": "allowed-tenant-b",
      "user": "demo-bob",
      "requestedTenantId": "tenant-b",
      "rpc": { "method": "sessions.list", "params": { "limit": 5 } },
      "expect": {
        "status": 200,
        "dispatched": true,
        "backendTenantId": "tenant-b",
        "authorization": "Bearer demo-token-tenant-b"
      }
    }
  ]
}
