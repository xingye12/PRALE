+        },
+        {
+            "path": "aider/models.py",
+            "symbol": "sanity_check_model",
+            "start_line": 1164,
+            "end_line": 1200,
+            "observation": "Makes unknown-model handling explicit: when no environment keys are known it emits 'Warning for <model>: Unknown which environment variables are required.' (line 1183), and when metadata is empty it emits 'Warning for <model>: Unknown context window size and costs, using sane defaults.' (lines 1190-1192), returning show=True (line 1200) so callers see a problem flag instead of silence."
+        }
+    ],
