+{
+  "task_id": "10",
+  "repository": "aider",
+  "mode": "demo",
+  "evidence": [
+    {
+      "path": "aider/models.py",
+      "symbol": "ModelInfoManager",
+      "start_line": 161,
+      "end_line": 323,
+      "observation": "The model-metadata lookup component. It pins the upstream litellm metadata URL (model_prices_and_context_window.json) and a 24h CACHE_TTL (lines 162-166), and in __init__ resolves a local on-disk cache at ~/.aider/caches/model_prices_and_context_window.json plus an in-memory local_model_metadata dict (168-177). fetch_openrouter_model_info (276-323) is the legacy scrape fallback. The class is the single indirection between aider and any metadata source, so it is the right seam to demonstrate the lookup path offline with a fixture cache."
+    },
+    {
+      "path": "aider/models.py",
+      "symbol": "ModelInfoManager._load_cache",
+      "start_line": 184,
+      "end_line": 201,
+      "observation": "Loads the local cache file only once per manager (_cache_loaded guard, 185-186) and only while cache_age < CACHE_TTL (191-192); a JSONDecodeError is treated exactly like a missing cache by resetting self.content to None (195-197). This is what makes a hand-written local fixture file a sufficient stand-in for the network: a fresh file is used verbatim, a stale or corrupted file simply falls through to _update_cache()."
+    },
+    {
+      "path": "aider/models.py",
+      "symbol": "ModelInfoManager.get_model_from_cached_json_db",
