+#!/usr/bin/env node
+/**
+ * Operate demo for generated-file path resolution + attachment utilities.
+ *
+ * Runs the pure resolver from `server/utils/generated-file-path.js` and the
+ * attachment helpers from `server/gateway-file-transfer.js` against a
+ * controlled, self-contained file fixture created inside the repository
+ * workspace, then reports for every request:
+ *   - the canonical (realpath) target
+ *   - the resolution mode
+ *   - the accept/reject decision and, for unsafe input, the rejection reason.
+ *
+ * The HTTP route in `server/handlers/files.js` (GET /api/chat/generated-file)
+ * is not exported, so the demo replays the exact acceptance gates that route
+ * composes around the imported resolver: realpath(-e), posix.relative escape
+ * check, denied-name/segment check, and regular-file check. The resolver and
+ * the attachment utilities themselves are imported from the repository, not
+ * re-implemented.
+ *
+ * Usage:  node scripts/operate-generated-file-path-demo.mjs
+ * Exit code 0 = all assertions passed; 1 = a fixture assertion failed.
+ */
+
+import fs from 'fs/promises'
+import path from 'path'
+import { posix } from 'path'
+import { fileURLToPath } from 'url'
+import { resolveGeneratedFileCandidatePath } from '../server/utils/generated-file-path.js'
+import {
+  sanitizeFilename,
+  buildRemoteFileName,
+  uploadToGateway,
+  deleteRemoteFile,
+  writeRemoteFile,
+} from '../server/gateway-file-transfer.js'
+
+const WORKSPACE_ROOT = fileURLToPath(new URL('..', import.meta.url))
+
+// ---- acceptance gates mirrored from server/handlers/files.js --------------
+const GENERATED_FILE_DENIED_SEGMENTS = new Set(['.git', '.openclaw'])
+const GENERATED_FILE_DENIED_NAMES = new Set([
+  'agents.md',
+  'soul.md',
+  'user.md',
+  'identity.md',
+  'tools.md',
+  'bootstrap.md',
+  'memory.md',
+  'workspace-state.json',
+  'openclaw-workspace-state.json',
+])
+const GENERATED_FILE_MAX_BYTES = 100 * 1024 * 1024
+
+function isGeneratedFilePathAllowed(relativePath) {
+  const segments = relativePath.split('/').filter(Boolean).map((segment) => segment.toLowerCase())
+  if (segments.some((segment) => GENERATED_FILE_DENIED_SEGMENTS.has(segment))) return false
+  const name = segments[segments.length - 1] || ''
+  if (name === '.env' || name.startsWith('.env.')) return false
+  return !GENERATED_FILE_DENIED_NAMES.has(name)
+}
+
+function generatedFileMimeType(filePath) {
+  const ext = posix.extname(filePath).slice(1).toLowerCase()
+  const types = {
+    pdf: 'application/pdf',
+    txt: 'text/plain',
+    md: 'text/markdown',
+    json: 'application/json',
+    png: 'image/png',
+  }
+  return types[ext] || 'application/octet-stream'
+}
+
+const pass = []
+const fail = []
+function check(label, condition, detail) {
+  if (condition) pass.push(label)
+  else fail.push(`${label}${detail ? ` -> ${detail}` : ''}`)
+}
+
+/** Replay GET /api/chat/generated-file decision flow for one requested path. */
+async function operate(workspaceReal, requestedPath) {
+  if (!requestedPath || requestedPath.includes('\0')) {
+    return { requestedPath, status: 400, decision: 'rejected', reason: 'Invalid generated file request' }
+  }
+  const { candidatePath, pathMode } = resolveGeneratedFileCandidatePath(workspaceReal, requestedPath)
+
+  let targetReal
+  try {
+    targetReal = await fs.realpath(candidatePath)
+  } catch {
+    return {
+      requestedPath,
+      pathMode,
+      candidatePath,
+      status: 404,
+      decision: 'rejected',
+      reason: 'File not found',
+      canonicalPath: null,
+    }
+  }
+
+  const relativePath = posix.relative(workspaceReal, targetReal)
+  const escapedWorkspace =
+    !relativePath || relativePath === '..' || relativePath.startsWith('../') || posix.isAbsolute(relativePath)
+
+  if (escapedWorkspace || !isGeneratedFilePathAllowed(relativePath)) {
+    return {
+      requestedPath,
+      pathMode,
+      candidatePath,
+      canonicalPath: targetReal,
+      status: 403,
+      decision: 'rejected',
+      reason: escapedWorkspace
+        ? `File access denied: resolves outside workspace root (realpath ${targetReal})`
+        : `File access denied: denied name or segment (${relativePath})`,
+      relativePath,
+    }
+  }
+
+  const stat = await fs.stat(targetReal)
+  if (!stat.isFile()) {
+    return {
+      requestedPath,
+      pathMode,
+      candidatePath,
+      canonicalPath: targetReal,
+      status: 400,
+      decision: 'rejected',
+      reason: 'Only regular files can be downloaded',
+      relativePath,
+    }
+  }
+  if (stat.size > GENERATED_FILE_MAX_BYTES) {
+    return {
+      requestedPath,
+      pathMode,
+      candidatePath,
+      canonicalPath: targetReal,
+      status: 413,
+      decision: 'rejected',
+      reason: 'File is too large to download',
+      relativePath,
+    }
+  }
+
+  return {
+    requestedPath,
+    pathMode,
+    candidatePath,
+    canonicalPath: targetReal,
+    relativePath,
+    status: 200,
+    decision: 'accepted',
+    reason: 'served',
+    size: stat.size,
+    mimeType: generatedFileMimeType(targetReal),
+  }
+}
+
+async function main() {
+  const fixtureRoot = await fs.mkdtemp(path.join(WORKSPACE_ROOT, '.operate-fixture-'))
+  const report = { fixtureRoot, pathOperations: [], attachments: {} }
+
+  try {
+    const ws = path.join(fixtureRoot, 'workspace')
+    const mediaDir = path.join(fixtureRoot, 'media', 'inbound')
+    await fs.mkdir(path.join(ws, 'downloads'), { recursive: true })
+    await fs.mkdir(path.join(ws, 'downloads', '.git'), { recursive: true })
+    await fs.mkdir(path.join(fixtureRoot, 'outside'), { recursive: true })
+
+    await fs.writeFile(path.join(ws, 'downloads', 'report.pdf'), '%PDF-1.4 fixture report\n')
+    await fs.writeFile(path.join(ws, 'downloads', 'notes.txt'), 'hello generated file\n')
+    await fs.writeFile(path.join(ws, 'downloads', '.env'), 'SECRET=1\n')
+    await fs.writeFile(path.join(ws, 'downloads', '.git', 'config'), '[core]\n')
+    await fs.writeFile(path.join(ws, 'AGENTS.md'), '# agent rules\n')
+    await fs.writeFile(path.join(fixtureRoot, 'outside', 'secret.txt'), 'outside the workspace\n')
+    await fs.symlink(path.join(fixtureRoot, 'outside', 'secret.txt'), path.join(ws, 'downloads', 'escape-link.txt'))
+
+    const workspaceReal = (await fs.realpath(ws)).replace(/\\/g, '/')
+    report.workspaceReal = workspaceReal
+
+    const cases = [
+      { input: 'downloads/report.pdf', expect: 200, note: 'relative input canonicalises under workspace root' },
+      { input: '/downloads/report.pdf', expect: 200, note: 'leading-slash input is re-rooted at workspace root' },
+      { input: './downloads/notes.txt', expect: 200, note: 'dot-relative input' },
+      { input: `${workspaceReal}/downloads/report.pdf`, expect: 200, note: 'workspace-absolute input preserved' },
+      { input: 'downloads/../downloads/report.pdf', expect: 200, note: 'interior .. that stays inside workspace' },
+      { input: '../outside/secret.txt', expect: 403, note: 'relative traversal escapes workspace' },
+      { input: '/../outside/secret.txt', expect: 403, note: 'absolute-style traversal escapes workspace' },
+      { input: 'downloads/../../outside/secret.txt', expect: 403, note: 'nested traversal escapes workspace' },
+      { input: 'downloads/escape-link.txt', expect: 403, note: 'symlink inside workspace resolves outside' },
+      { input: 'downloads/.env', expect: 403, note: 'denied dotenv name' },
+      { input: '/downloads/.git/config', expect: 403, note: 'denied .git segment' },
+      { input: 'AGENTS.md', expect: 403, note: 'denied agent instruction file (case-insensitive)' },
+      { input: '/etc/hostname', expect: 404, note: 'host absolute path re-rooted, never escapes to host fs' },
+      { input: 'downloads', expect: 400, note: 'directory is not a downloadable regular file' },
+      { input: 'downloads/missing.pdf', expect: 404, note: 'missing target' },
+      { input: `downloads/report.pdf\0.txt`, expect: 400, note: 'NUL byte rejected before resolution' },
+    ]
+
+    for (const c of cases) {
+      const result = await operate(workspaceReal, c.input)
+      report.pathOperations.push({ ...result, expectation: c.expect, note: c.note })
+      check(
+        `operate(${JSON.stringify(c.input)}) -> ${c.expect}`,
+        result.status === c.expect,
+        `got ${result.status} (${result.reason})`,
+      )
+    }
+
+    // --- canonical path assertions -----------------------------------------
+    const relative = report.pathOperations[0]
+    const rootRelative = report.pathOperations[1]
+    const absoluteIn = report.pathOperations[3]
+    check(
+      'relative input canonical path',
+      relative.canonicalPath === `${workspaceReal}/downloads/report.pdf` && relative.pathMode === 'workspace-relative',
+      JSON.stringify(relative),
+    )
+    check(
+      'root-relative input canonical path',
+      rootRelative.canonicalPath === `${workspaceReal}/downloads/report.pdf` &&
+        rootRelative.pathMode === 'workspace-root-relative',
+      JSON.stringify(rootRelative),
+    )
+    check(
+      'workspace-absolute input preserved',
+      absoluteIn.pathMode === 'workspace-absolute' && absoluteIn.candidatePath === absoluteIn.canonicalPath,
+      JSON.stringify(absoluteIn),
+    )
+    const traversal = report.pathOperations[5]
+    check(
+      'traversal rejection reason names the escape',
+      traversal.status === 403 && /outside workspace root/.test(traversal.reason),
+      traversal.reason,
+    )
+    check(
+      'symlink escape rejection reason names the escape',
+      report.pathOperations[8].status === 403 && /outside workspace root/.test(report.pathOperations[8].reason),
+      report.pathOperations[8].reason,
+    )
+    check(
+      'host absolute path stayed inside workspace',
+      report.pathOperations[12].pathMode === 'workspace-root-relative' &&
+        report.pathOperations[12].candidatePath.startsWith(workspaceReal),
+      JSON.stringify(report.pathOperations[12]),
+    )
+
+    // --- attachment utilities ---------------------------------------------
+    const sanitized = [
+      sanitizeFilename('../etc/passwd'),
+      sanitizeFilename('报表 2026?.pdf'),
+      sanitizeFilename('  '),
+      sanitizeFilename('a'.repeat(80) + '.pdf'),
+    ]
+    report.attachments.sanitizeFilename = {
+      input: ['../etc/passwd', '报表 2026?.pdf', '  ', `${'a'.repeat(80)}.pdf`],
+      output: sanitized,
+    }
+    check('sanitizeFilename strips separators', !sanitized[0].includes('/') && !sanitized[0].includes('\\'), sanitized[0])
+    check('sanitizeFilename keeps unicode + extension', sanitized[1] === '报表_2026_.pdf', sanitized[1])
+    check('sanitizeFilename blank -> empty (caller falls back to "file")', sanitized[2] === '', JSON.stringify(sanitized[2]))
+    check('sanitizeFilename caps at 60 chars', sanitized[3].length === 60, String(sanitized[3].length))
+
+    const built = buildRemoteFileName('../../etc/passwd')
+    const builtNormal = buildRemoteFileName('季度 报告 2026.pdf')
+    report.attachments.buildRemoteFileName = { traversal: built, normal: builtNormal }
+    check('buildRemoteFileName has no path separators', !built.fileName.includes('/') && !built.fileName.includes('\\'), built.fileName)
+    check('buildRemoteFileName matches name---uuid.ext', /^.*---[0-9a-f]{8}$/.test(built.fileName), built.fileName)
+    check(
+      'buildRemoteFileName keeps ext lowercased',
+      builtNormal.ext === '.pdf' && builtNormal.fileName.endsWith('.pdf'),
+      JSON.stringify(builtNormal),
+    )
+
+    const upload = await uploadToGateway(Buffer.from('fixture payload'), '季度 报告.pdf', { GATEWAY_MEDIA_DIR: mediaDir })
+    report.attachments.uploadToGateway = upload
+    check(
+      'uploadToGateway writes inside GATEWAY_MEDIA_DIR',
+      upload.path === `${mediaDir.replace(/\\/g, '/')}/${upload.fileName}` && upload.path.startsWith(mediaDir),
+      upload.path,
+    )
+    check(
+      'uploadToGateway content round-trips',
+      (await fs.readFile(upload.path, 'utf-8')) === 'fixture payload' && upload.size === 15,
+      String(upload.size),
+    )
+    check('uploadToGateway uses traversal-safe name', !upload.fileName.includes('/'), upload.fileName)
+
+    const deleted = await deleteRemoteFile(upload.path)
+    const deletedAgain = await deleteRemoteFile(upload.path)
+    report.attachments.deleteRemoteFile = { first: deleted, second: deletedAgain }
+    check('deleteRemoteFile removes file and is idempotent', deleted === true && deletedAgain === true)
+
+    await fs.mkdir(mediaDir, { recursive: true })
+    const blocker = path.join(mediaDir, 'blocked.txt')
+    await fs.writeFile(blocker, 'i am a file, not a directory')
+    const nested = path.join(mediaDir, 'nested', 'deep', 'note.txt')
+    const wrote = await writeRemoteFile(nested, 'written by demo')
+    const wroteBad = await writeRemoteFile(path.join(blocker, 'child.txt'), 'nope')
+    report.attachments.writeRemoteFile = { wrote, wroteBad, nested, blocker }
+    check('writeRemoteFile creates parents and content', wrote === true && (await fs.readFile(nested, 'utf-8')) === 'written by demo')
+    check('writeRemoteFile reports false when parent path is a file (ENOTDIR)', wroteBad === false, String(wroteBad))
+
+    report.assertions = { passed: pass.length, failed: fail.length, failures: fail }
+    console.log(JSON.stringify(report, null, 2))
+  } finally {
+    await fs.rm(fixtureRoot, { recursive: true, force: true })
+  }
+
+  if (fail.length > 0) {
+    console.error(`\nDEMO FAILED: ${fail.length} assertion(s) failed`)
+    process.exitCode = 1
+  } else {
+    console.error(`\nDEMO OK: ${pass.length} assertions passed; fixture removed`)
+  }
+}
+
