@@ -0,0 +1,349 @@
+"""State-transition tests for the FileWatcher session/watch lifecycle helper.
+
+Helper under test
+-----------------
+``aider.watch.FileWatcher`` owns the watch *session* lifecycle and the
+*command* edge that feeds detected edits back into the coding session:
+
+* ``start()``      -- begin a watch session (opens a thread + stop event)
+* ``stop()``       -- end the watch session (signal + join + clear refs)
+* ``handle_changes()`` -- command edge: accept a batch of detected changes
+
+The tests model the helper as a two-state machine:
+
+    idle  --start()-->  running
+    running --stop()--> idle
+    running --handle_changes(changes)--> running
+    running --handle_changes([])--> running   (no-op)
+
+and drive both *legal* and *illegal* edges through the real source:
+
+* legal edges must land the machine in the documented state and produce the
+  documented side effects (``changed_files`` update, ``io.interrupt_input``),
+* illegal edges must either be tolerated as a safe no-op or rejected with a
+  deterministic exception (never corrupt the state silently).
+
+Dependency note
+---------------
+``aider/watch.py`` imports the optional ``grep_ast`` and ``watchfiles`` packages
+at module import time even though none of the lifecycle helpers above call into
+them (``grep_ast`` is only used by ``process_changes``).  When those optional
+dependencies are unavailable we inject minimal stubs so the *real*
+``FileWatcher`` source can still be exercised; the ``fake_watch`` fixture always
+replaces ``watch`` with a deterministic, scripted generator so the session
+lifecycle is reproducible without a filesystem watcher backend.
+"""
+
+import importlib
+import sys
+import threading
+import types
+
+import pytest
+
+
+def _import_aider_watch():
+    """Import ``aider.watch`` even when optional watch deps are missing."""
+    injected = {}
+    for name in ("grep_ast", "watchfiles"):
+        try:
+            importlib.import_module(name)
+            continue
+        except ImportError:
+            pass
+        stub = types.ModuleType(name)
+        if name == "grep_ast":
+            # Only referenced by process_changes(), never by the lifecycle.
+            stub.TreeContext = type("TreeContext", (), {})
+        else:
+            # Replaced per-test by the ``fake_watch`` fixture.
+            def watch(*args, **kwargs):  # pragma: no cover - placeholder
+                raise RuntimeError("watchfiles stub: patch aider.watch.watch")
+
+            stub.watch = watch
+        injected[name] = stub
+        sys.modules[name] = stub
+    return importlib.import_module("aider.watch")
+
+
+watch_module = _import_aider_watch()
+FileWatcher = watch_module.FileWatcher
+
+
+# --------------------------------------------------------------------------- #
+# Test doubles
+# --------------------------------------------------------------------------- #
+class FakeIO:
+    def __init__(self):
+        self.file_watcher = None
+        self.interrupts = 0
+
+    def interrupt_input(self):
+        self.interrupts += 1
+
+
+class FakeCoder:
+    def __init__(self, root):
+        self.io = FakeIO()
+        self.root = root
+        self.abs_fnames = set()
+
+    def get_rel_fname(self, fname):
+        return fname
+
+
+@pytest.fixture
+def fake_watch(monkeypatch):
+    """Replace ``aider.watch.watch`` with a scriptable blocking generator."""
+
+    def install(script=()):
+        calls = []
+
+        def _fake_watch(*paths, watch_filter=None, stop_event=None,
+                        ignore_permission_denied=False):
+            calls.append(tuple(paths))
+            for changes in script:
+                yield changes
+            # Keep the session "running" until stop() signals the event.
+            while stop_event is not None and not stop_event.is_set():
+                stop_event.wait(0.005)
+
+        monkeypatch.setattr(watch_module, "watch", _fake_watch)
+        return calls
+
+    return install
+
+
+def make_watcher(tmp_path):
+    coder = FakeCoder(root=tmp_path)
+    watcher = FileWatcher(coder, root=tmp_path)
+    return watcher, coder
+
+
+def state(watcher):
+    """Collapse the observable session state to ``idle`` or ``running``."""
+    thread = watcher.watcher_thread
+    if thread is not None and thread.is_alive():
+        return "running"
+    return "idle"
+
+
+# --------------------------------------------------------------------------- #
+# Initial / idle state
+# --------------------------------------------------------------------------- #
+def test_fresh_watcher_is_idle(tmp_path):
+    watcher, _ = make_watcher(tmp_path)
+    assert state(watcher) == "idle"
+    assert watcher.stop_event is None
+    assert watcher.watcher_thread is None
+    assert watcher.changed_files == set()
+
+
+# --------------------------------------------------------------------------- #
+# Legal edges
+# --------------------------------------------------------------------------- #
+LEGAL_EDGES = [
+    # (start_state, operation, expected_state)
+    ("idle", "start", "running"),
+    ("running", "stop", "idle"),
+    ("running", "changes", "running"),
+    ("running", "nochange", "running"),
+]
+
+
+def test_legal_edge_start_enters_running_and_resets_changes(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+    watcher.changed_files.add("stale.py")
+
+    watcher.start()
+    try:
+        assert state(watcher) == "running"
+        assert isinstance(watcher.stop_event, threading.Event)
+        assert watcher.changed_files == set()  # start() clears per-session state
+    finally:
+        watcher.stop()
+
+
+def test_legal_edge_handle_changes_updates_state_while_running(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, coder = make_watcher(tmp_path)
+    watcher.start()
+    try:
+        changed = [("modified", str(tmp_path / "a.py")), ("added", str(tmp_path / "b.py"))]
+        assert watcher.handle_changes(changed) is True
+        assert watcher.changed_files == {str(tmp_path / "a.py"), str(tmp_path / "b.py")}
+        assert coder.io.interrupts == 1
+        assert state(watcher) == "running"  # command edge keeps the session alive
+    finally:
+        watcher.stop()
+
+
+def test_legal_edge_handle_changes_empty_is_noop(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, coder = make_watcher(tmp_path)
+    watcher.start()
+    try:
+        before = set(watcher.changed_files)
+        assert watcher.handle_changes([]) is False
+        assert watcher.changed_files == before
+        assert coder.io.interrupts == 0
+        assert state(watcher) == "running"
+    finally:
+        watcher.stop()
+
+
+def test_legal_edge_stop_returns_to_idle(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+    watcher.start()
+    watcher.stop()
+    assert state(watcher) == "idle"
+    assert watcher.watcher_thread is None
+    assert watcher.stop_event is None
+
+
+def test_legal_edge_start_stop_start_cycles(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+    watcher.start()
+    assert state(watcher) == "running"
+    watcher.stop()
+    assert state(watcher) == "idle"
+    watcher.start()  # a fresh session after a clean stop is legal
+    try:
+        assert state(watcher) == "running"
+    finally:
+        watcher.stop()
+    assert state(watcher) == "idle"
+
+
+def test_watch_files_forwards_first_change_batch(tmp_path, fake_watch):
+    """The thread body reuses handle_changes() and returns on the first batch."""
+    calls = fake_watch(script=[[("modified", str(tmp_path / "hit.py"))]])
+    watcher, coder = make_watcher(tmp_path)
+
+    watcher.stop_event = threading.Event()
+    watcher.watch_files()  # returns as soon as handle_changes() reports True
+
+    assert calls  # watch() was actually driven
+    assert watcher.changed_files == {str(tmp_path / "hit.py")}
+    assert coder.io.interrupts == 1
+
+
+# --------------------------------------------------------------------------- #
+# Illegal edges (must be tolerated or rejected deterministically)
+# --------------------------------------------------------------------------- #
+ILLEGAL_EDGES = [
+    ("idle", "stop", "idle"),      # stop before start -- tolerated no-op
+    ("idle", "nochange", "idle"),  # empty command before start -- tolerated
+]
+
+
+def test_illegal_edge_stop_before_start_is_tolerated(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+    # stop() must not raise even though no session was ever started.
+    watcher.stop()
+    assert state(watcher) == "idle"
+    assert watcher.stop_event is None
+    assert watcher.watcher_thread is None
+
+
+def test_illegal_edge_double_stop_is_idempotent(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+    watcher.start()
+    watcher.stop()
+    watcher.stop()  # second stop on an already-idle session: safe no-op
+    assert state(watcher) == "idle"
+    assert watcher.stop_event is None
+    assert watcher.watcher_thread is None
+
+
+def test_illegal_edge_handle_changes_before_start_bootstraps_state(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, coder = make_watcher(tmp_path)
+    # No session running yet; the command still records the batch (tolerated).
+    assert watcher.handle_changes([("modified", str(tmp_path / "x.py"))]) is True
+    assert watcher.changed_files == {str(tmp_path / "x.py")}
+    assert state(watcher) == "idle"  # ...but it does NOT start a session
+
+
+def test_illegal_edge_double_start_abandons_previous_session(tmp_path, fake_watch):
+    """start() is not idempotent: a second start() drops the first session's
+    thread/stop-event references, so stop() can only end the newest session."""
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+
+    watcher.start()
+    first_thread, first_event = watcher.watcher_thread, watcher.stop_event
+
+    watcher.start()  # illegal: session already running
+    assert watcher.watcher_thread is not first_thread
+    assert watcher.stop_event is not first_event
+    assert state(watcher) == "running"
+
+    # Cleanup: stop() only knows about the newest session, so retire the
+    # abandoned first session explicitly to avoid leaking a blocked thread.
+    first_event.set()
+    first_thread.join(timeout=2)
+    watcher.stop()
+    assert state(watcher) == "idle"
+    assert not first_thread.is_alive()
+
+
+def test_illegal_edge_malformed_change_is_rejected(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, coder = make_watcher(tmp_path)
+    # A "change" with no path component cannot be normalized and must fail
+    # loudly rather than silently record a bogus entry.
+    with pytest.raises((IndexError, TypeError)):
+        watcher.handle_changes([("modified",)])
+    assert watcher.changed_files == set()
+    assert coder.io.interrupts == 0
+
+
+def test_illegal_edge_none_changes_is_tolerated(tmp_path, fake_watch):
+    fake_watch(script=())
+    watcher, _ = make_watcher(tmp_path)
+    assert watcher.handle_changes(None) is False  # falsy input treated as empty
+    assert watcher.changed_files == set()
+
+
+# --------------------------------------------------------------------------- #
+# Explicit transition table: legal edges reach the documented state,
+# illegal edges never move the machine off its current state.
+# --------------------------------------------------------------------------- #
+@pytest.mark.parametrize("start_state, operation, expected_state", LEGAL_EDGES)
