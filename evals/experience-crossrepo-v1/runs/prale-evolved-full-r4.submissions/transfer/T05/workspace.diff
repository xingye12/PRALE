+{
+  "description": "User-controlled attachment metadata fixtures for the generated-file download normalizer. Every `attachment.requestedPath` value is attacker-influenced (it arrives from the browser query string / an attachment card), while the workspace root is server-derived. `expected` records the lexical normalization produced by resolveGeneratedFileCandidatePath().",
+  "cases": [
+    {
+      "name": "leading-slash path is treated as workspace-root-relative",
+      "workspaceReal": "/home/wattman/.wattclaw/user/report-agent",
+      "attachment": {
+        "fileName": "report.pdf",
+        "requestedPath": "/downloads/report.pdf",
+        "declaredMimeType": "application/pdf",
+        "declaredSizeBytes": 20480
+      },
+      "expected": {
+        "candidatePath": "/home/wattman/.wattclaw/user/report-agent/downloads/report.pdf",
+        "pathMode": "workspace-root-relative"
+      }
+    },
+    {
+      "name": "plain relative path is treated as workspace-relative",
+      "workspaceReal": "/home/wattman/.wattclaw/user/report-agent",
+      "attachment": {
+        "fileName": "report.pdf",
+        "requestedPath": "downloads/report.pdf",
+        "declaredMimeType": "application/pdf",
+        "declaredSizeBytes": 20480
+      },
+      "expected": {
+        "candidatePath": "/home/wattman/.wattclaw/user/report-agent/downloads/report.pdf",
+        "pathMode": "workspace-relative"
+      }
+    },
+    {
+      "name": "declared client metadata never changes the normalized path",
+      "workspaceReal": "/home/wattman/.wattclaw/user/report-agent",
+      "attachment": {
+        "fileName": "../../etc/passwd",
+        "requestedPath": "downloads/report.pdf",
+        "declaredMimeType": "application/x-msdownload",
+        "declaredSizeBytes": 4294967295
+      },
+      "expected": {
+        "candidatePath": "/home/wattman/.wattclaw/user/report-agent/downloads/report.pdf",
+        "pathMode": "workspace-relative"
+      }
+    },
+    {
+      "name": "windows-style separators are unified to forward slashes",
+      "workspaceReal": "/home/wattman/.wattclaw/user/report-agent",
+      "attachment": {
+        "fileName": "q1 report.csv",
+        "requestedPath": "downloads\\2026\\q1 report.csv",
+        "declaredMimeType": "text/csv",
+        "declaredSizeBytes": 128
+      },
+      "expected": {
+        "candidatePath": "/home/wattman/.wattclaw/user/report-agent/downloads/2026/q1 report.csv",
+        "pathMode": "workspace-relative"
+      }
+    },
+    {
+      "name": "repeated leading slashes collapse into one workspace join",
+      "workspaceReal": "/home/wattman/.wattclaw/user/report-agent",
+      "attachment": {
+        "fileName": "report.pdf",
+        "requestedPath": "//downloads//report.pdf",
+        "declaredMimeType": "application/pdf",
+        "declaredSizeBytes": 20480
+      },
+      "expected": {
+        "candidatePath": "/home/wattman/.wattclaw/user/report-agent/downloads//report.pdf",
+        "pathMode": "workspace-root-relative"
+      }
+    },
+    {
+      "name": "absolute path already inside the workspace is preserved verbatim",
+      "workspaceReal": "/home/wattman/.wattclaw/user/report-agent",
+      "attachment": {
+        "fileName": "notes.md",
+        "requestedPath": "/home/wattman/.wattclaw/user/report-agent/notes.md",
