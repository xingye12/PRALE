diff --git a/tests/basic/test_t06_fake_transport.py b/tests/basic/test_t06_fake_transport.py
new file mode 100644
index 0000000..ae1cf7f
--- /dev/null
+++ b/tests/basic/test_t06_fake_transport.py
@@ -0,0 +1,184 @@
+"""T06 contract demo: external/model helper exercised through a fake transport.
+
+Contract under test (aider):
+
+* ``aider/llm.py`` exposes ``LazyLiteLLM`` -- the external/model helper that
+  defers importing the third-party ``litellm`` provider client until an
+  attribute is first accessed, then pins safe global flags on it
+  (``suppress_debug_info``, ``set_verbose``, ``drop_params`` and
+  ``_logging._disable_debugging()``).
+* ``aider/sendchat.py`` exposes the request-shaping helpers
+  ``sanity_check_messages`` and ``ensure_alternating_roles`` that normalise the
+  ``messages`` field of a model request before it is handed to the transport.
+
+The "fake transport" is a recording stand-in for the external ``litellm``
+module injected into ``sys.modules``.  The demo asserts the exact request
+fields the helper forwards and that no real provider / socket access happens.
+
+Run either way::
+
+    python -m pytest tests/basic/test_t06_fake_transport.py -q
+    python tests/basic/test_t06_fake_transport.py
+"""
+
+import socket
+import sys
+import types
+import unittest
+from unittest import mock
+
+# ---------------------------------------------------------------------------
+# Sandbox note: ``aider.utils`` (imported transitively by ``aider.sendchat``)
+# imports the third-party ``oslex`` package, which is not installed here.
+# Injecting a stub into ``sys.modules`` keeps the demo hermetic; the limitation
+# is recorded in the validation artifact instead of installing dependencies.
+# ---------------------------------------------------------------------------
+if "oslex" not in sys.modules:
+    try:
+        import oslex  # noqa: F401
+    except ImportError:
+        sys.modules["oslex"] = types.ModuleType("oslex")
+
+from aider.llm import LazyLiteLLM  # noqa: E402
+from aider.sendchat import ensure_alternating_roles, sanity_check_messages  # noqa: E402
+
+
+class RecordingTransport(types.ModuleType):
+    """Fake transport standing in for the external ``litellm`` client module.
+
+    It records every request handed to it so the demo can assert the request
+    fields, and it never performs any I/O.
+    """
+
+    def __init__(self):
+        super().__init__("litellm")
+        self.requests = []
+        self.debugging_disabled = False
+
+        transport_logging = types.ModuleType("litellm._logging")
+
+        def _disable_debugging():
+            self.debugging_disabled = True
+
+        transport_logging._disable_debugging = _disable_debugging
+        self._logging = transport_logging
+
+    def completion(self, **kwargs):
+        self.requests.append(kwargs)
+        return types.SimpleNamespace(
+            choices=[types.SimpleNamespace(message=types.SimpleNamespace(content="ok"))]
+        )
+
+
+def _safe_messages():
+    """A valid user/assistant request shape for the ``messages`` field."""
+    return [
+        {"role": "user", "content": "write a hello world"},
+        {"role": "assistant", "content": "sure"},
+        {"role": "user", "content": "now in python"},
+    ]
+
+
+class TestExternalModelHelperFakeTransport(unittest.TestCase):
+    """Drive ``aider.llm.LazyLiteLLM`` against a fake transport."""
+
+    def setUp(self):
+        self._saved_litellm = sys.modules.get("litellm")
+        self.transport = RecordingTransport()
+        sys.modules["litellm"] = self.transport
+
+    def tearDown(self):
+        if self._saved_litellm is None:
+            sys.modules.pop("litellm", None)
+        else:
+            sys.modules["litellm"] = self._saved_litellm
+
+    def test_helper_defers_transport_import_until_first_use(self):
+        helper = LazyLiteLLM()
+        # No attribute touched yet -> the external transport is not imported.
+        assert helper._lazy_module is None
+        assert self.transport.requests == []
+
+        completion = helper.completion  # first attribute access triggers load
+        assert helper._lazy_module is self.transport
+        assert callable(completion)
+        # Loading alone must not issue a request.
+        assert self.transport.requests == []
+
+    def test_helper_pins_safe_flags_on_transport(self):
+        helper = LazyLiteLLM()
+        helper.completion  # force load
+        assert self.transport.suppress_debug_info is True
+        assert self.transport.set_verbose is False
+        assert self.transport.drop_params is True
+        assert self.transport.debugging_disabled is True
+
+    def test_request_fields_forwarded_verbatim(self):
+        helper = LazyLiteLLM()
+        request = dict(
+            model="gpt-4",
+            stream=False,
+            temperature=0,
+            messages=_safe_messages(),
+        )
+
+        helper.completion(**request)
+
+        assert len(self.transport.requests) == 1
+        recorded = self.transport.requests[0]
+        assert recorded["model"] == "gpt-4"
+        assert recorded["stream"] is False
+        assert recorded["temperature"] == 0
+        assert recorded["messages"] == _safe_messages()
+
+    def test_no_hidden_network_access(self):
+        def _forbid_socket(*args, **kwargs):
+            raise AssertionError("hidden network access attempted")
+
+        with mock.patch.object(socket, "socket", _forbid_socket):
+            helper = LazyLiteLLM()
+            helper.completion(model="gpt-4", messages=_safe_messages(), stream=False)
+
+        # The external client resolved to the injected fake, never the real one.
+        assert helper._lazy_module is self.transport
+        assert sys.modules["litellm"] is self.transport
+        assert len(self.transport.requests) == 1
+
+    def test_module_level_helper_stays_unloaded(self):
+        import aider.llm
+
+        assert isinstance(aider.llm.litellm, LazyLiteLLM)
+        # The shared singleton must not have imported the real provider client.
+        assert aider.llm.litellm._lazy_module is None
+
+
+class TestMessageFieldContract(unittest.TestCase):
+    """``aider.sendchat`` shapes the ``messages`` request field."""
+
+    def test_sanity_check_accepts_alternating_roles(self):
+        assert sanity_check_messages(_safe_messages()) is True
+
+    def test_sanity_check_rejects_consecutive_user_roles(self):
+        with self.assertRaises(ValueError):
+            sanity_check_messages(
+                [{"role": "user", "content": "a"}, {"role": "user", "content": "b"}]
+            )
+
+    def test_sanity_check_requires_user_last(self):
+        assert sanity_check_messages([{"role": "assistant", "content": "hi"}]) is False
+
+    def test_ensure_alternating_roles_inserts_empty_opposite_role(self):
+        fixed = ensure_alternating_roles(
+            [{"role": "user", "content": "a"}, {"role": "user", "content": "b"}]
+        )
+        assert fixed == [
+            {"role": "user", "content": "a"},
+            {"role": "assistant", "content": ""},
+            {"role": "user", "content": "b"},
+        ]
+        # The normalised shape stays valid for the transport layer.
+        assert sanity_check_messages(fixed) is True
+
+
+if __name__ == "__main__":
+    unittest.main()
