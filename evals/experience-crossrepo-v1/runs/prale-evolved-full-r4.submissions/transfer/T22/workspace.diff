+++ b/server/core/process-result.demo.mjs
@@ -0,0 +1,132 @@
+// Executable demo / validation for `server/core/process-result.js`.
+//
+// Run: node server/core/process-result.demo.mjs
+//
+// It drives three fake-backend child-process failures through
+// `runCommandResult` and asserts that the structured server result keeps the
+// diagnostics (exit code, signal, stdout, stderr, timeout) that
+// `system.js#localExec` collapses into a single Error message. Exits non-zero
+// if any assertion fails.
+
+import assert from 'node:assert/strict'
+import { EventEmitter } from 'node:events'
+import { execFileSync } from 'node:child_process'
+
+import {
+  PROCESS_FAILURE_KIND,
+  normalizeProcessFailure,
+  runCommandResult,
+} from './process-result.js'
+
+const node = process.execPath
+const print = (label, value) => console.log(`${label}\n${JSON.stringify(value, null, 2)}\n`)
+
+// ── 1. Fake backend exits non-zero, but wrote diagnostics to both streams ──
+const exitCmd = `${node} -e "process.stdout.write('partial payload'); process.stderr.write('fake-backend: upstream 503'); process.exit(3)"`
+const nonzero = await runCommandResult(exitCmd)
+
+print('[1] nonzero exit normalized', nonzero)
+assert.equal(nonzero.ok, false)
+assert.equal(nonzero.error.kind, PROCESS_FAILURE_KIND.NONZERO_EXIT)
+assert.equal(nonzero.error.code, 'PROCESS_NONZERO_EXIT')
+assert.equal(nonzero.error.diagnostics.exitCode, 3)
+assert.match(nonzero.error.diagnostics.stdout, /partial payload/)
+assert.match(nonzero.error.diagnostics.stderr, /upstream 503/)
+// The lossy baseline: collapsing into a message-only envelope drops exit code
+// and stdout, which is what `localExec`'s rejection forces on callers.
+const lossy = { ok: false, error: nonzero.error.message }
+assert.equal(typeof lossy.error, 'string')
+assert.equal(lossy.error.diagnostics, undefined)
+confidenceCheck('nonzero exit', [
+  ['exitCode preserved', nonzero.error.diagnostics.exitCode === 3],
+  ['stdout preserved', nonzero.error.diagnostics.stdout.includes('partial payload')],
+  ['stderr preserved', nonzero.error.diagnostics.stderr.includes('upstream 503')],
+  ['message-only envelope loses diagnostics', lossy.error.diagnostics === undefined],
+])
+
+// ── 2. Fake backend cannot be spawned at all (injected ENOENT 'error' event) ──
+function fakeFailingSpawn() {
+  const child = new EventEmitter()
+  child.stdout = new EventEmitter()
+  child.stderr = new EventEmitter()
+  child.kill = () => true
+  setImmediate(() => {
+    const err = new Error('spawn fake-backend ENOENT')
+    err.code = 'ENOENT'
+    err.errno = -2
+    err.syscall = 'spawn fake-backend'
+    child.emit('error', err)
+  })
+  return child
+}
+const spawnError = await runCommandResult('fake-backend --probe', { spawnImpl: fakeFailingSpawn })
+
+print('[2] spawn error normalized', spawnError)
+assert.equal(spawnError.ok, false)
+assert.equal(spawnError.error.kind, PROCESS_FAILURE_KIND.SPAWN_ERROR)
+assert.equal(spawnError.error.code, 'PROCESS_SPAWN_ERROR')
+assert.equal(spawnError.error.diagnostics.spawnCode, 'ENOENT')
+assert.equal(spawnError.error.diagnostics.errno, -2)
+assert.equal(spawnError.error.diagnostics.command, 'fake-backend --probe')
+confidenceCheck('spawn error', [
+  ['ENOENT code preserved', spawnError.error.diagnostics.spawnCode === 'ENOENT'],
+  ['errno preserved', spawnError.error.diagnostics.errno === -2],
+  ['command preserved', spawnError.error.diagnostics.command === 'fake-backend --probe'],
+])
+
+// ── 3. Fake backend hangs; timeout kills it but keeps partial output ──
+const hangCmd = `${node} -e "process.stdout.write('starting'); setTimeout(() => {}, 10000)"`
+const timedOut = await runCommandResult(hangCmd, { timeoutMs: 500 })
+
+print('[3] timeout normalized', timedOut)
+assert.equal(timedOut.ok, false)
+assert.equal(timedOut.error.kind, PROCESS_FAILURE_KIND.TIMEOUT)
+assert.equal(timedOut.error.code, 'PROCESS_TIMEOUT')
+assert.equal(timedOut.error.diagnostics.timedOut, true)
+assert.equal(timedOut.error.diagnostics.timeoutMs, 500)
+confidenceCheck('timeout', [
+  ['timedOut flagged', timedOut.error.diagnostics.timedOut === true],
+  ['timeoutMs preserved', timedOut.error.diagnostics.timeoutMs === 500],
+  ['partial stdout preserved', timedOut.error.diagnostics.stdout.includes('starting')],
+])
+
+// ── 4. Success path still resolves with a structured payload ──
+const okResult = await runCommandResult(`${node} -e "process.stdout.write('ok')"`)
+print('[4] success normalized', okResult)
+assert.equal(okResult.ok, true)
+assert.equal(okResult.payload.exitCode, 0)
+assert.equal(okResult.payload.stdout, 'ok')
+confidenceCheck('success', [
+  ['ok flag set', okResult.payload.stdout === 'ok'],
+  ['exitCode zero', okResult.payload.exitCode === 0],
+])
+
+// ── 5. `normalizeProcessFailure` is total (never throws) on bare errors ──
+const bare = normalizeProcessFailure(new Error('boom'))
+print('[5] bare error normalized', bare)
+assert.equal(bare.ok, false)
+assert.equal(bare.error.kind, PROCESS_FAILURE_KIND.SPAWN_ERROR)
+confidenceCheck('bare error', [
+  ['never throws', bare.ok === false],
+  ['diagnostics bundle present', typeof bare.error.diagnostics.stderr === 'string'],
+])
+
+// ── 6. Cited contract symbols are still present in the source files ──
+const cited = [
+  ['server/core/system.js', 'localExec'],
+  ['server/core/system.js', 'gatewayExec'],
+  ['server/core/gateway-client.js', 'gatewayAdminRpcForTarget'],
+  ['server/core/gateway-client.js', '_sanitizeLogParams'],
+]
+for (const [file, symbol] of cited) {
+  const out = execFileSync('grep', ['-c', symbol, file], { encoding: 'utf8' }).trim()
+  assert.ok(Number(out) >= 1, `${symbol} missing from ${file}`)
+}
+console.log('[6] cited symbols present:', cited.map(([f, s]) => `${s}@${f}`).join(', '))
+
+function confidenceCheck(name, checks) {
+  const failed = checks.filter(([, ok]) => !ok)
+  if (failed.length) throw new Error(`${name}: failed ${failed.map(([c]) => c).join('; ')}`)
+}
+
+console.log('\nALL CHECKS PASSED')
