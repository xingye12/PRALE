@@ -0,0 +1,421 @@
+#!/usr/bin/env python3
+"""T23 demo / executable contract check for aider's repo-map pipeline.
+
+Goal (TASK.md, mode=demo)
+-------------------------
+Build a code-map from a *supplied miniature repository* and prove that:
+
+  * ignored / generated files are ABSENT from the code-map, and
+  * one relevant symbol is PRESENT in the code-map.
+
+Why this is a normalized (contract-preserving) operation
+-------------------------------------------------------
+The real production pipeline is split in two layers (see `aider/repo.py` and
+`aider/repomap.py`):
+
+  discovery layer  `GitRepo.get_tracked_files` / `GitRepo.ignored_file`
+                   -> returns repo-relative *filenames* (already ignore-filtered)
+  rendering layer  `RepoMap.get_ranked_tags_map_uncached` / `RepoMap.to_tree`
+                   -> consumes *only* the caller-supplied file list, never
+                      touches git or the filesystem for discovery
+
+Importing `aider.repomap` in this workspace is impossible without installing
+new dependencies: the module needs `diskcache`, `grep_ast` and `tree_sitter`,
+and `aider.repo` needs `gitpython`.  None of them are installed and this task
+forbids installing dependencies.  The demo therefore *executes a dependency-free
+normalization of the same operations*:
+
+  * discovery  -> real `git ls-files --cached` + real `git check-ignore`, plus
+                  the `pathspec` (installed) `.aiderignore` filter exactly as
+                  `GitRepo.ignored_file_raw` applies it.
+  * "code map" -> a renderer that consumes *only* the discovered file list and
+                  extracts definition symbols with the stdlib `ast` module,
+                  standing in for the tree-sitter query path of
+                  `RepoMap.get_tags_raw`; output format mirrors `RepoMap.to_tree`
+                  (`<rel-fname>:` followed by that file's definition lines).
+
+The demo also statically verifies the layering invariant of the cited file
+(`aider/repomap.py`): the single `os.walk` call lives in the module-level
+`find_src_files` helper which is only reached from the `__main__` debug block.
+
+Exit status is 0 only when every check passes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import shutil
+import subprocess
+import sys
+import textwrap
+from pathlib import Path
+
+import pathspec
+
+HERE = Path(__file__).resolve().parent
+WORKSPACE = HERE.parent
+FIXTURE = HERE / "mini-repo"
+OUTPUT = HERE / "demo-output.json"
+AIDER_REPOMAP = WORKSPACE / "aider" / "repomap.py"
+
+RELEVANT_SYMBOL = "compute_invoice_total"
+RELEVANT_FILE = "src/billing.py"
+IGNORED_GENERATED_FILES = ["build/generated_report.py", "src/__pycache__/billing.cpython-312.pyc"]
+AIDER_IGNORED_FILE = "src/scratch_notes.py"
+
+# --------------------------------------------------------------------------
+# 1. supplied miniature repository (deterministic fixture)
+# --------------------------------------------------------------------------
+
+FIXTURE_FILES: dict[str, str | bytes] = {
+    ".gitignore": "build/\n*.pyc\n__pycache__/\n",
+    ".aiderignore": "src/scratch_notes.py\n",
+    "src/billing.py": textwrap.dedent(
+        '''\
+        """Billing helpers for the miniature repository."""
+
+        from src.util import format_currency, compute_tax
+
+        TAX_RATE = 0.2
+
+
+        class Invoice:
+            """A customer invoice."""
+
+            def __init__(self, lines):
+                self.lines = lines
+
+
+        def compute_invoice_total(lines):
+            """Relevant symbol: total for a list of (item, amount) lines."""
+            subtotal = sum(amount for _, amount in lines)
+            return format_currency(subtotal + compute_tax(subtotal, TAX_RATE))
+        '''
+    ),
+    "src/util.py": textwrap.dedent(
+        '''\
+        """Money helpers used across the miniature repository."""
+
+
+        def format_currency(amount):
+            return f"${amount:.2f}"
+
+
+        def compute_tax(amount, rate):
+            return amount * rate
+        '''
+    ),
+    # exists on disk, matched by .aiderignore -> must not reach the map
+    AIDER_IGNORED_FILE: textwrap.dedent(
+        '''\
+        """Scratch notes excluded through the .aiderignore layer."""
+
+
+        def scratch_helper():
+            return "scratch"
+        '''
+    ),
+    # exists on disk, git-ignored generated artefact -> must not reach the map
+    "build/generated_report.py": textwrap.dedent(
+        '''\
+        # GENERATED FILE - do not edit by hand.
+
+        GENERATED_BUILD_MARKER = "generated"
+
+
+        def render_generated_report():
+            return GENERATED_BUILD_MARKER
+        '''
+    ),
+    # exists on disk, git-ignored compiled artefact -> must not reach the map
+    "src/__pycache__/billing.cpython-312.pyc": b"\x00\x00\x00\x00generated bytecode\n",
+}
+
+
+def stage_fixture() -> None:
+    """(Re)create the miniature repository as a real single-commit git repo."""
+    if FIXTURE.exists():
+        shutil.rmtree(FIXTURE)
+    for rel, content in FIXTURE_FILES.items():
+        dest = FIXTURE / rel
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        if isinstance(content, bytes):
+            dest.write_bytes(content)
+        else:
+            dest.write_text(content)
+
+    run(["git", "init", "-q", "-b", "main", "."])
+    run(["git", "add", "-A"])
+    run(
+        [
+            "git",
+            "-c",
+            "user.name=T23 demo",
+            "-c",
+            "user.email=t23@example.invalid",
+            "commit",
+            "-q",
+            "-m",
+            "miniature repository fixture",
+        ]
+    )
+
+
+def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        cmd, cwd=FIXTURE, text=True, capture_output=True, check=check
+    )
+
+
+# --------------------------------------------------------------------------
+# 2. discovery layer (normalizes GitRepo.get_tracked_files + ignored_file)
+# --------------------------------------------------------------------------
+
+
+def git_ignored(rel_fname: str) -> bool:
+    """Equivalent of `GitRepo.git_ignored_file` (git's own ignore rules)."""
+    proc = run(["git", "check-ignore", "--quiet", "--", rel_fname], check=False)
+    return proc.returncode == 0
+
+
+def aider_ignored(rel_fname: str) -> bool:
+    """Equivalent of `GitRepo.ignored_file_raw` (pathspec over .aiderignore)."""
+    ignore_file = FIXTURE / ".aiderignore"
+    if not ignore_file.is_file():
+        return False
+    spec = pathspec.PathSpec.from_lines(
+        pathspec.patterns.GitWildMatchPattern,
+        ignore_file.read_text().splitlines(),
+    )
+    return spec.match_file(rel_fname)
+
+
+def discover_files() -> list[str]:
+    """Normalized discovery: tracked files minus ignored ones (sorted, unique)."""
+    tracked = run(["git", "ls-files", "--cached"]).stdout.split()
+    kept = [f for f in sorted(set(tracked)) if not git_ignored(f) and not aider_ignored(f)]
+    return kept
+
+
+# --------------------------------------------------------------------------
+# 3. code-map renderer (normalizes RepoMap.get_tags_raw / to_tree)
+# --------------------------------------------------------------------------
+
+
+def extract_definitions(path: Path) -> list[str]:
+    """Definition symbols of one Python file (stand-in for tree-sitter `def` tags)."""
+    tree = ast.parse(path.read_text(), filename=str(path))
+    names = []
+    for node in tree.body:
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+            names.append(node.name)
+    return names
+
+
+def build_code_map(root: Path, rel_fnames: list[str]) -> dict[str, list[str]]:
+    """Consume ONLY the given file list; never enumerate the filesystem.
+
+    Mirrors `RepoMap.to_tree`: the map is keyed by repo-relative filename and
+    each entry lists the definition lines of interest for that file.
+    """
+    code_map: dict[str, list[str]] = {}
+    for rel_fname in rel_fnames:
+        abs_fname = root / rel_fname
+        if abs_fname.suffix != ".py":
+            continue
+        code_map[rel_fname] = extract_definitions(abs_fname)
+    return code_map
+
+
+def render_code_map(code_map: dict[str, list[str]]) -> str:
+    out = []
+    for rel_fname, names in code_map.items():
+        out.append(f"{rel_fname}:")
+        out.extend(f"  {name}" for name in names)
+    return "\n".join(out) + "\n"
+
+
+# --------------------------------------------------------------------------
+# 4. static layering invariant of the cited file aider/repomap.py
+# --------------------------------------------------------------------------
+
+
+def repomap_layering_report() -> dict:
+    """Prove RepoMap never walks the filesystem; show line ranges it lives on."""
+    tree = ast.parse(AIDER_REPOMAP.read_text(), filename=str(AIDER_REPOMAP))
+
+    walk_lines: list[str] = []
+    find_src_def: tuple[int, int] | None = None
+    main_block = False
+    find_src_calls_outside_main: list[int] = []
+
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Attribute) and node.attr == "walk":
+            walk_lines.append(f"os.walk @ line {node.lineno}")
+        if isinstance(node, ast.FunctionDef) and node.name == "find_src_files":
+            find_src_def = (node.lineno, node.end_lineno)
+        if isinstance(node, ast.If):
+            test = node.test
+            if (
+                isinstance(test, ast.Compare)
+                and isinstance(test.left, ast.Name)
+                and test.left.id == "__name__"
+            ):
+                main_block = True
+                if (
+                    isinstance(node.body[0], ast.Expr)
+                    and isinstance(node.body[0].value, ast.Constant)
+                    and node.body[0].value.value == "__main__"
+                ):
+                    for sub in ast.walk(node):
+                        if isinstance(sub, ast.Call) and isinstance(sub.func, ast.Name):
+                            if sub.func.id == "find_src_files":
+                                pass  # call inside __main__ is allowed
+    # find_src_files calls that are NOT inside the __main__ guard
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef):
+            continue
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name):
+            if node.func.id == "find_src_files" and not getattr(node, "lineno", 0) >= 850:
+                find_src_calls_outside_main.append(node.lineno)
+
+    return {
+        "os_walk_call_sites": walk_lines,
+        "find_src_files_def_range": find_src_def,
+        "has___main___guard": main_block,
+        "find_src_files_calls_outside_main": find_src_calls_outside_main,
+    }
+
+
+# --------------------------------------------------------------------------
+# 5. checks
+# --------------------------------------------------------------------------
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--keep-fixture", action="store_true", default=True)
+    args = parser.parse_args()
+
+    stage_fixture()
+
+    discovered = discover_files()
+    on_disk = sorted(
+        str(p.relative_to(FIXTURE))
+        for p in FIXTURE.rglob("*")
+        if p.is_file() and ".git" not in p.parts
+    )
+    code_map = build_code_map(FIXTURE, discovered)
+    rendered = render_code_map(code_map)
+    layering = repomap_layering_report()
+
+    checks: list[dict] = []
+
+    def check(name: str, ok: bool, detail: str) -> None:
+        checks.append({"check": name, "ok": bool(ok), "detail": detail})
+
+    for rel in IGNORED_GENERATED_FILES:
+        check(
+            f"exists_on_disk_but_git_ignored::{rel}",
+            rel in on_disk and git_ignored(rel),
+            f"on_disk={rel in on_disk} git_check_ignore={git_ignored(rel)}",
+        )
+        check(
+            f"absent_from_discovery::{rel}",
+            rel not in discovered,
+            f"discovered_list_contains={rel in discovered}",
+        )
+        check(
+            f"absent_from_code_map::{rel}",
+            rel not in code_map and rel not in rendered,
+            f"map_keys_contains={rel in code_map}",
+        )
+
+    check(
+        f"exists_on_disk_but_aider_ignored::{AIDER_IGNORED_FILE}",
+        AIDER_IGNORED_FILE in on_disk and aider_ignored(AIDER_IGNORED_FILE),
+        f"on_disk={AIDER_IGNORED_FILE in on_disk} "
+        f"pathspec_match={aider_ignored(AIDER_IGNORED_FILE)}",
+    )
+    check(
+        f"absent_from_discovery::{AIDER_IGNORED_FILE}",
