+        "GENERATED_BUILD_MARKER" not in rendered and "render_generated_report" not in rendered,
+        "symbols GENERATED_BUILD_MARKER / render_generated_report not present in rendered map",
+    )
+    check(
+        "relevant_file_present",
+        RELEVANT_FILE in code_map,
+        f"{RELEVANT_FILE} in map keys: {RELEVANT_FILE in code_map}",
+    )
+    check(
+        "relevant_symbol_present",
+        RELEVANT_SYMBOL in code_map.get(RELEVANT_FILE, []),
+        f"{RELEVANT_FILE} definitions = {code_map.get(RELEVANT_FILE)}",
+    )
+    check(
+        "map_keys_subset_of_discovered",
+        set(code_map).issubset(set(discovered)),
+        "renderer consumed only the caller-supplied discovery list",
+    )
+    check(
+        "no_ignored_file_in_map_keys",
+        all(f not in code_map for f in IGNORED_GENERATED_FILES + [AIDER_IGNORED_FILE]),
+        f"map keys = {sorted(code_map)}",
+    )
+    check(
+        "layering_single_os_walk_in_find_src_files",
+        len(layering["os_walk_call_sites"]) == 1
+        and layering["find_src_files_def_range"] is not None,
+        f"{layering['os_walk_call_sites']} inside find_src_files "
+        f"{layering['find_src_files_def_range']}",
+    )
+    check(
+        "layering_find_src_files_not_called_outside_main",
+        not layering["find_src_files_calls_outside_main"] and layering["has___main___guard"],
+        f"calls_outside_main={layering['find_src_files_calls_outside_main']} "
+        f"main_guard={layering['has___main___guard']}",
+    )
+
+    passed = all(c["ok"] for c in checks)
+    result = {
+        "demo": "T23 build-code-map from miniature repository",
+        "task_id": "T23",
+        "repository": "aider",
+        "mode": "demo",
+        "status": "pass" if passed else "fail",
+        "fixture_root": ".prale-eval/mini-repo",
+        "on_disk_files": on_disk,
+        "discovered_files": discovered,
+        "code_map": code_map,
+        "rendered_code_map": rendered,
+        "checks": checks,
+    }
+    OUTPUT.write_text(json.dumps(result, indent=2) + "\n")
+
+    print("=== T23 demo: miniature repository -> code-map ===")
+    print(f"fixture            : {FIXTURE.relative_to(WORKSPACE)}")
+    print(f"files on disk      : {on_disk}")
+    print(f"discovered files   : {discovered}")
+    print("--- rendered code map ---")
+    print(rendered, end="")
+    print("--- checks ---")
+    for c in checks:
+        print(f"[{'PASS' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}")
+    print(f"--- status: {result['status']} ({sum(c['ok'] for c in checks)}/{len(checks)} checks) ---")
+    print(f"machine-readable output: {OUTPUT.relative_to(WORKSPACE)}")
+
+    if not args.keep_fixture:
+        shutil.rmtree(FIXTURE)
+    return 0 if passed else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
