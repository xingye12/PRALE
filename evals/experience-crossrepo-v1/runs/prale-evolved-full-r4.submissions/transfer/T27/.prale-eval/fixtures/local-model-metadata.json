{
    // T27 local model metadata fixture (JSON5, loaded via
    // aider.models.register_litellm_models). This is deliberately NOT the
    // bundled aider/resources/model-metadata.json: it describes exactly one
    // custom local model and nothing else, so any other model name is unknown.
    "local/known-fixture-model": {
        "max_tokens": 4096,
        "max_input_tokens": 32768,
        "max_output_tokens": 4096,
        "input_cost_per_token": 0.0,
        "output_cost_per_token": 0.0,
        "litellm_provider": "local",
        "mode": "chat",
        // Capabilities are stated EXPLICITLY for the known model. There is no
        // entry at all for "local/unknown-fixture-model", so its capabilities
        // must stay unclaimed rather than defaulting to true.
        "supports_function_calling": false,
        "supports_tool_choice": false,
        "supports_prompt_caching": false
    }
}
