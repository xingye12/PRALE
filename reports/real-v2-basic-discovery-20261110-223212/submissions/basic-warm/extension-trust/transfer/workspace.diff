diff --git a/.prale-eval/regression.mjs b/.prale-eval/regression.mjs
new file mode 100644
index 0000000..ea93a3b
--- /dev/null
+++ b/.prale-eval/regression.mjs
@@ -0,0 +1,127 @@
+/**
+ * Regression for extension-trust/transfer.
+ *
+ * Exercises the real DefaultResourceLoader.reload() lifecycle through
+ * `.prale-eval/subject.mjs` and asserts that:
+ *   1. the bootstrap pass keeps project extensions excluded (untrusted settings),
+ *   2. an explicit `true` AND an explicit `false` trust decision are both honored,
+ *   3. settings are reloaded for the decided trust state before the final resource
+ *      resolution sees it.
+ *
+ * Run with: node --experimental-vm-modules .prale-eval/regression.mjs
+ */
+import assert from "node:assert/strict";
+import { fileURLToPath } from "node:url";
+import { createTrustSubject } from "./subject.mjs";
+
+const root = fileURLToPath(new URL("..", import.meta.url));
+
+// Array.from keeps the result in this realm so assert.deepEqual compares values, not
+// cross-realm Array prototypes (the loader runs inside a vm context).
+const basenames = (extensions) => Array.from(extensions, (extension) => extension.path.split(/[\\/]/).pop());
+const sorted = (values) => Array.from(values).sort();
+const eventsOf = (events, kind) => events.map((event, index) => ({ event, index })).filter(({ event }) => event[0] === kind);
+const firstEvent = (events, kind) => eventsOf(events, kind)[0];
+const lastEvent = (events, kind) => eventsOf(events, kind).at(-1);
+
+/** Bootstrap pass must never see project-local extensions or trusted settings. */
+async function assertBootstrapIsUntrusted(initialTrusted) {
+	const subject = await createTrustSubject(root, { initialTrusted });
+	const bootstrap = await subject.loader.loadProjectTrustExtensions();
+
+	const names = basenames(bootstrap.extensions);
+	assert.ok(
+		!names.includes("project.ts"),
+		`bootstrap loaded a project extension while resolving trust: ${JSON.stringify(names)}`,
+	);
+	assert.deepEqual(sorted(names), ["cli.ts", "user.ts"], `unexpected bootstrap extensions: ${JSON.stringify(names)}`);
+
+	const bootstrapResolve = firstEvent(subject.events, "resolve");
+	assert.ok(bootstrapResolve, "bootstrap never asked the package manager to resolve resources");
+	assert.equal(
+		bootstrapResolve.event[1],
+		false,
+		`bootstrap resolved resources with trusted settings: ${JSON.stringify(bootstrapResolve.event)}`,
+	);
+}
+
+/** A full reload with an explicit decision must honor that decision. */
+async function assertDecisionHonored(initialTrusted, decision) {
+	const subject = await createTrustSubject(root, { initialTrusted });
+	const seenByDecision = [];
+
+	await subject.loader.reload({
+		resolveProjectTrust: async ({ extensionsResult }) => {
+			seenByDecision.push(sorted(basenames(extensionsResult.extensions)));
+			return decision;
+		},
+	});
+
+	assert.equal(seenByDecision.length, 1, "resolveProjectTrust must be consulted exactly once");
+	assert.deepEqual(
+		seenByDecision[0],
+		["cli.ts", "user.ts"],
+		`trust decision was made with project resources already loaded: ${JSON.stringify(seenByDecision[0])}`,
+	);
+
+	// The trust decision must reach the package manager before the final resolution.
+	const decisionResolve = lastEvent(subject.events, "resolve");
+	assert.ok(decisionResolve, "reload never resolved resources");
+	assert.equal(
+		decisionResolve.event[1],
+		decision,
+		`final resource resolution ignored the explicit trust decision ${decision}: ${JSON.stringify(decisionResolve.event)}`,
+	);
+
+	const decisionSet = eventsOf(subject.events, "set").filter(({ event }) => event[1] === decision).at(-1);
+	assert.ok(decisionSet, `explicit trust decision ${decision} was never applied to the settings manager`);
+
+	// Nothing may flip trust back between applying the decision and resolving resources.
+	const overrides = subject.events
+		.slice(decisionSet.index + 1, decisionResolve.index)
+		.filter((event) => event[0] === "set" && event[1] !== decision);
+	assert.deepEqual(
+		overrides,
+		[],
+		`trust decision ${decision} was overridden before resource resolution: ${JSON.stringify(overrides)}`,
+	);
+
+	// Settings must be reloaded for the decided trust state, not the bootstrap state.
+	const reloadsForDecision = subject.events
+		.slice(decisionSet.index + 1, decisionResolve.index)
+		.filter((event) => event[0] === "settings" && event[1] === decision);
+	assert.ok(
+		reloadsForDecision.length > 0,
+		`settings were not reloaded for trust decision ${decision} before resource resolution: ${JSON.stringify(
+			subject.events.slice(decisionSet.index, decisionResolve.index + 1),
+		)}`,
+	);
+
+	const finalNames = basenames(subject.loader.getExtensions().extensions);
+	if (decision) {
+		assert.ok(
+			finalNames.includes("project.ts"),
+			`trusted decision ${decision} (bootstrap trusted: ${initialTrusted}) did not load project extensions: ${JSON.stringify(finalNames)}`,
+		);
+		assert.deepEqual(sorted(finalNames), ["cli.ts", "project.ts", "user.ts"], `unexpected trusted extensions: ${JSON.stringify(finalNames)}`);
+	} else {
+		assert.ok(
+			!finalNames.includes("project.ts"),
+			`untrusted decision ${decision} (bootstrap trusted: ${initialTrusted}) loaded project extensions: ${JSON.stringify(finalNames)}`,
+		);
+		assert.deepEqual(sorted(finalNames), ["cli.ts", "user.ts"], `unexpected untrusted extensions: ${JSON.stringify(finalNames)}`);
+	}
+
+	// The settings manager must end up in the decided trust state.
+	assert.equal(
+		subject.state.trusted,
+		decision,
+		`settings manager trust state did not end at the explicit decision ${decision}`,
+	);
+}
+
+for (const initialTrusted of [true, false]) {
+	await assertBootstrapIsUntrusted(initialTrusted);
+	await assertDecisionHonored(initialTrusted, true);
+	await assertDecisionHonored(initialTrusted, false);
+}
