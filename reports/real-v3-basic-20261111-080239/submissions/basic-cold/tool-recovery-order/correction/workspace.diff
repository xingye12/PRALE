+	// cancel_requested exactly as a concurrent cancel request would (this is the flag runParallel
+	// forwards to recovery for the remaining calls in the batch).
+	harness.lane.onToolStart = (event) => {
+		if (event.toolCallId !== "call-0") return;
+		harness.lane.cancelRequested = true;
+		harness.lane.state = harness.lane.state;
+	};
+
+	await runTools(harness.lane, harness.drive, harness.run);
+
+	assert.deepEqual(
+		harness.executions,
+		["safe-first"],
+		"a cancellation must stop the remaining verified safe replays instead of invoking them",
+	);
+	const cancelled = resultMessage(harness.store, "result-1");
+	assert.equal(cancelled.isError, true, "a cancelled safe call must report an interrupted effect");
+	assert.equal(cancelled.content[0].text, "second checkpoint", "a cancelled safe call must keep its durable checkpoint");
+	assert.ok(lastText(cancelled).includes(INTERRUPTION_MARKER));
+	assert.equal(
+		harness.lane.events.some((event) => event.type === "tool_start" && event.toolCallId === "call-1"),
+		false,
+		"a cancelled safe call must not publish a tool_start",
+	);
+}
+
+console.log("ok: safe/safe recovery replays once and unsafe, missing and cancelled declarations stay interrupted");
